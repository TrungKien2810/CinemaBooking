@model PromotionFormModel
@{
    var isEdit = Model.Id is not null;
    ViewData["Title"] = (isEdit ? "Sửa khuyến mãi" : "Thêm khuyến mãi") + " — " + Model.TheaterName;
}

<div class="admin-page-head">
    <div>
        <a asp-action="Index" asp-route-theaterId="@Model.TheaterId" class="back-link">← Khuyến mãi · @Model.TheaterName</a>
        <h1 class="page-title">@(isEdit ? "Sửa khuyến mãi" : "Thêm khuyến mãi")</h1>
    </div>
</div>

<form asp-action="@(isEdit ? "Edit" : "Create")" asp-route-id="@Model.Id" method="post" class="cb-card admin-form admin-form-narrow">
    <div asp-validation-summary="ModelOnly"></div>
    <input asp-for="TheaterId" type="hidden" />

    <div class="mb-3">
        <label asp-for="Title" class="form-label"></label>
        <input asp-for="Title" class="form-control" placeholder="Thứ 3 vui vẻ" />
        <span asp-validation-for="Title" class="text-danger small"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Badge" class="form-label"></label>
        <input asp-for="Badge" class="form-control" placeholder="Đồng giá 60k" />
        <span asp-validation-for="Badge" class="text-danger small"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Description" class="form-label"></label>
        <textarea asp-for="Description" class="form-control" rows="3"></textarea>
        <span asp-validation-for="Description" class="text-danger small"></span>
    </div>
    <div class="row">
        <div class="col-sm-6 mb-3">
            <label asp-for="StartDate" class="form-label"></label>
            <input asp-for="StartDate" type="date" class="form-control" />
            <span asp-validation-for="StartDate" class="text-danger small"></span>
        </div>
        <div class="col-sm-6 mb-3">
            <label asp-for="EndDate" class="form-label"></label>
            <input asp-for="EndDate" type="date" class="form-control" />
            <span asp-validation-for="EndDate" class="text-danger small"></span>
        </div>
    </div>
    <div class="form-check mb-3">
        <input asp-for="IsActive" class="form-check-input" />
        <label asp-for="IsActive" class="form-check-label"></label>
    </div>
    <p class="form-text">Khuyến mãi hiện là thông tin quảng bá trên trang chi nhánh; giá vé khi thanh toán chưa tự giảm.</p>

    <div class="admin-form-actions">
        <button type="submit" class="btn btn-primary">Lưu</button>
        <a asp-action="Index" asp-route-theaterId="@Model.TheaterId" class="btn btn-link">Hủy</a>
    </div>
</form>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
