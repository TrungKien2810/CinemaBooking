@{
    ViewData["Title"] = "Chưa được gán chi nhánh";
}

<div class="cb-card cb-empty">
    <div class="error-icon" aria-hidden="true">🏢</div>
    <p class="cb-empty-title">Tài khoản chưa được gán chi nhánh</p>
    <p class="cb-muted">
        Bạn đang đăng nhập bằng tài khoản quản lý chi nhánh nhưng chưa được gán chi nhánh nào
        (hoặc chi nhánh trước đó đã bị gỡ). Liên hệ quản trị viên hệ thống để được gán lại.
    </p>
</div>
