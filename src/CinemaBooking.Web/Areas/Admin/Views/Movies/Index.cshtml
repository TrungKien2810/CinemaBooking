@model List<Movie>
@{
    ViewData["Title"] = "Quản lý phim";
    var activeCount = Model.Count(m => m.IsActive);
}

<div class="admin-page-head">
    <div class="admin-page-title-wrap">
        <h1 class="admin-page-title">Phim</h1>
        <p class="admin-page-subtitle">@activeCount phim đang chiếu · @(Model.Count - activeCount) phim đã ẩn</p>
    </div>
    <div class="admin-page-actions">
        <a asp-action="Create" class="cb-btn cb-btn-primary">
            <span>+</span> Thêm phim
        </a>
    </div>
</div>

@if (Model.Count == 0)
{
    <div class="cb-empty">
        <div class="cb-empty-icon" aria-hidden="true">🎬</div>
        <h3 class="cb-empty-title">Chưa có phim nào</h3>
        <p class="cb-empty-desc">Thêm phim đầu tiên để bắt đầu cấu hình suất chiếu và bán vé.</p>
        <a asp-action="Create" class="cb-btn cb-btn-primary">Thêm phim ngay</a>
    </div>
}
else
{
    <div class="admin-table-wrap">
        <table class="admin-table">
            <thead>
                <tr>
                    <th>Phim</th>
                    <th>Thể loại</th>
                    <th class="cb-num">Thời lượng</th>
                    <th>Khởi chiếu</th>
                    <th>Trạng thái</th>
                    <th class="admin-actions">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var m in Model)
                {
                    <tr class="@(m.IsActive ? null : "is-inactive")">
                        <td>
                            <div class="admin-movie-cell">
                                <img src="@(string.IsNullOrWhiteSpace(m.PosterUrl) ? MovieCardViewModel.PlaceholderPoster : m.PosterUrl)"
                                     data-poster-fallback="@MovieCardViewModel.PlaceholderPoster"
                                     alt="" class="admin-poster-thumb" loading="lazy" width="36" height="54" />
                                <span style="font-weight: 600;">@m.Title</span>
                            </div>
                        </td>
                        <td>
                            <span class="cb-badge cb-badge-surface">@(m.Genre ?? "—")</span>
                        </td>
                        <td class="cb-num">@m.DurationMinutes phút</td>
                        <td class="cb-num" style="text-align: left !important;">@m.ReleaseDate.ToString("dd/MM/yyyy")</td>
                        <td>
                            <span class="status-badge @(m.IsActive ? "is-on" : "is-off")">
                                @(m.IsActive ? "Đang chiếu" : "Đã ẩn")
                            </span>
                        </td>
                        <td class="admin-actions">
                            <div style="display: inline-flex; gap: 0.35rem; align-items: center;">
                                <a asp-action="Edit" asp-route-id="@m.Id" class="cb-btn cb-btn-secondary cb-btn-sm">Sửa</a>
                                @if (m.IsActive)
                                {
                                    <form asp-action="Delete" asp-route-id="@m.Id" method="post" style="display: inline;"
                                          data-confirm="Ẩn phim “@m.Title” khỏi trang khách?">
                                        <button type="submit" class="cb-btn cb-btn-danger cb-btn-sm">Ẩn</button>
                                    </form>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
