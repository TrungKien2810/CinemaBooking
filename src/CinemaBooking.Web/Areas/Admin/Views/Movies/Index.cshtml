@model List<Movie>
@{
    ViewData["Title"] = "Quản lý phim";
    var activeCount = Model.Count(m => m.IsActive);
}

<div class="admin-page-head">
    <div>
        <h1 class="page-title">Phim</h1>
        <p class="cb-muted page-subtitle">@activeCount phim đang chiếu · @(Model.Count - activeCount) phim đã ẩn</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">Thêm phim</a>
</div>

@if (Model.Count == 0)
{
    <div class="cb-card empty-state">
        <p class="empty-title">Chưa có phim nào</p>
        <p class="cb-muted">Thêm phim đầu tiên để bắt đầu xếp lịch chiếu.</p>
    </div>
}
else
{
    <div class="cb-card admin-table-wrap">
        <table class="table admin-table align-middle mb-0">
            <thead>
                <tr>
                    <th>Phim</th>
                    <th>Thể loại</th>
                    <th class="text-end">Thời lượng</th>
                    <th>Khởi chiếu</th>
                    <th>Trạng thái</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var m in Model)
                {
                    <tr class="@(m.IsActive ? null : "is-inactive")">
                        <td>
                            <div class="admin-movie-cell">
                                <img src="@(string.IsNullOrWhiteSpace(m.PosterUrl) ? MovieCardViewModel.PlaceholderPoster : m.PosterUrl)"
                                     data-poster-fallback="@MovieCardViewModel.PlaceholderPoster"
                                     alt="" class="admin-poster-thumb" loading="lazy" width="36" height="54" />
                                <span class="fw-semibold">@m.Title</span>
                            </div>
                        </td>
                        <td>@(m.Genre ?? "—")</td>
                        <td class="text-end text-nowrap">@m.DurationMinutes phút</td>
                        <td class="text-nowrap">@m.ReleaseDate.ToString("dd/MM/yyyy")</td>
                        <td>
                            <span class="status-badge @(m.IsActive ? "is-on" : "is-off")">@(m.IsActive ? "Đang chiếu" : "Đã ẩn")</span>
                        </td>
                        <td class="admin-actions">
                            <a asp-action="Edit" asp-route-id="@m.Id" class="btn btn-sm btn-outline-secondary">Sửa</a>
                            @if (m.IsActive)
                            {
                                <form asp-action="Delete" asp-route-id="@m.Id" method="post" class="d-inline"
                                      data-confirm="Ẩn phim “@m.Title” khỏi trang khách?">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Ẩn</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
