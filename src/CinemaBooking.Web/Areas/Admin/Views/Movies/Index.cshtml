@model MoviesIndexViewModel
@{
    ViewData["Title"] = "Quản lý phim";
}

<div class="admin-page-head">
    <div>
        <h1 class="page-title">Phim</h1>
        <p class="cb-muted page-subtitle">@Model.ActiveTotal phim đang bật · @(Model.Total - Model.ActiveTotal) phim đã ẩn@(Model.IsFiltered ? " · đang hiện " + Model.Items.Count : "")</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">Thêm phim</a>
</div>

<form method="get" class="cb-card admin-filter" role="search">
    <input name="q" value="@Model.Query" type="search" class="form-control" style="max-width:18rem" maxlength="100"
           placeholder="Tìm tên phim, đạo diễn, diễn viên…" aria-label="Tìm phim" />
    <select name="status" class="form-select" style="max-width:12rem" aria-label="Trạng thái">
        <option value="">Mọi trạng thái</option>
        <option value="active" selected="@(Model.Status == "active")">Đang chiếu</option>
        <option value="soon" selected="@(Model.Status == "soon")">Sắp chiếu</option>
        <option value="hidden" selected="@(Model.Status == "hidden")">Đã ẩn</option>
    </select>
    <select name="genre" class="form-select" style="max-width:12rem" aria-label="Thể loại">
        <option value="">Mọi thể loại</option>
        @foreach (var g in Model.Genres)
        {
            <option value="@g" selected="@(g == Model.Genre)">@g</option>
        }
    </select>
    <button type="submit" class="btn btn-outline-primary">Lọc</button>
    @if (Model.IsFiltered) { <a asp-action="Index" class="btn btn-link">Xóa lọc</a> }
</form>

@if (Model.Items.Count == 0)
{
    <div class="cb-card empty-state">
        @if (Model.IsFiltered)
        {
            <p class="empty-title">Không có phim khớp bộ lọc</p>
            <p class="cb-muted">Thử từ khóa khác (không cần gõ dấu) hoặc <a asp-action="Index">xóa bộ lọc</a>.</p>
        }
        else
        {
            <p class="empty-title">Chưa có phim nào</p>
            <p class="cb-muted">Thêm phim đầu tiên để bắt đầu xếp lịch chiếu.</p>
        }
    </div>
}
else
{
    <div class="cb-card admin-table-wrap">
        <table class="table admin-table align-middle mb-0">
            <thead>
                <tr>
                    <th>Phim</th>
                    <th>Thể loại</th>
                    <th class="text-end">Thời lượng</th>
                    <th>Khởi chiếu</th>
                    <th>Trạng thái</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var m in Model.Items)
                {
                    <tr class="@(m.IsActive ? null : "is-inactive")">
                        <td>
                            <div class="admin-movie-cell">
                                <img src="@(string.IsNullOrWhiteSpace(m.PosterUrl) ? MovieCardViewModel.PlaceholderPoster : m.PosterUrl)"
                                     data-poster-fallback="@MovieCardViewModel.PlaceholderPoster"
                                     alt="" class="admin-poster-thumb" loading="lazy" width="36" height="54" />
                                <span class="fw-semibold">@m.Title</span>
                            </div>
                        </td>
                        <td>@(m.Genre ?? "—")</td>
                        <td class="text-end text-nowrap">@m.DurationMinutes phút</td>
                        <td class="text-nowrap">@m.ReleaseDate.ToString("dd/MM/yyyy")</td>
                        <td>
                            <span class="status-badge @(m.IsActive ? "is-on" : "is-off")">@(m.IsActive ? "Đang chiếu" : "Đã ẩn")</span>
                        </td>
                        <td class="admin-actions">
                            <a asp-action="Edit" asp-route-id="@m.Id" class="btn btn-sm btn-outline-secondary">Sửa</a>
                            @if (m.IsActive)
                            {
                                <form asp-action="Delete" asp-route-id="@m.Id" method="post" class="d-inline"
                                      data-confirm="Ẩn phim “@m.Title” khỏi trang khách?">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Ẩn</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
