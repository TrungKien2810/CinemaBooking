@model MovieFormModel
@{
    var isEdit = Model.Id is not null;
    ViewData["Title"] = isEdit ? "Sửa phim" : "Thêm phim";
    var poster = string.IsNullOrWhiteSpace(Model.PosterUrl) ? MovieCardViewModel.PlaceholderPoster : Model.PosterUrl;
}

<div class="admin-page-head">
    <div class="admin-page-title-wrap">
        <a asp-action="Index" class="admin-back-link">← Danh sách phim</a>
        <h1 class="admin-page-title">@ViewData["Title"]</h1>
        <p class="admin-page-subtitle">Nhập thông tin chi tiết của phim để hiển thị trên hệ thống đặt vé.</p>
    </div>
</div>

<form asp-action="@(isEdit ? "Edit" : "Create")" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data" class="admin-form"
      data-confirm="@(isEdit ? "Lưu thay đổi phim này? Khách sẽ thấy thông tin mới ngay. Nếu bỏ chọn hiển thị, phim sẽ bị ẩn khỏi trang khách." : null)">
    <div asp-validation-summary="ModelOnly" class="cb-alert cb-alert-danger" style="margin-bottom: 1.5rem;"></div>

    <div class="admin-form-layout-poster">
        <div>
            <div class="admin-form-group">
                <label asp-for="Title" class="admin-label"></label>
                <input asp-for="Title" class="admin-input" placeholder="Ví dụ: Đào, Phở và Piano" />
                <span asp-validation-for="Title" class="admin-form-error"></span>
            </div>

            <div class="admin-form-grid admin-form-grid-3">
                <div class="admin-form-group">
                    <label asp-for="Genre" class="admin-label"></label>
                    <input asp-for="Genre" class="admin-input" placeholder="Hành động, Tâm lý…" />
                    <span asp-validation-for="Genre" class="admin-form-error"></span>
                </div>
                <div class="admin-form-group">
                    <label asp-for="DurationMinutes" class="admin-label"></label>
                    <input asp-for="DurationMinutes" class="admin-input" type="number" min="1" placeholder="Phút" />
                    <span asp-validation-for="DurationMinutes" class="admin-form-error"></span>
                </div>
                <div class="admin-form-group">
                    <label asp-for="ReleaseDate" class="admin-label"></label>
                    <input asp-for="ReleaseDate" type="date" class="admin-input" />
                    <span asp-validation-for="ReleaseDate" class="admin-form-error"></span>
                </div>
            </div>

            <div class="admin-form-group">
                <label asp-for="PosterUrl" class="admin-label"></label>
                <input asp-for="PosterUrl" class="admin-input" placeholder="https://… hoặc /img/…" data-poster-input />
                <span asp-validation-for="PosterUrl" class="admin-form-error"></span>
            </div>

            <div class="admin-form-group">
                <label asp-for="PosterFile" class="admin-label"></label>
                <input asp-for="PosterFile" class="admin-input" accept=".jpg,.jpeg,.png,.webp" />
                <div class="admin-form-hint">JPG, PNG hoặc WEBP, tối đa 5 MB. Có ảnh tải lên thì ảnh này được dùng thay cho URL.</div>
                <span asp-validation-for="PosterFile" class="admin-form-error"></span>
            </div>

            <div class="admin-form-grid">
                <div class="admin-form-group">
                    <label asp-for="AgeRating" class="admin-label"></label>
                    <select asp-for="AgeRating" class="admin-input">
                        @foreach (var r in Enum.GetValues<CinemaBooking.Domain.Enums.AgeRating>())
                        {
                            <option value="@r" selected="@(r == Model.AgeRating)">@r.Describe()</option>
                        }
                    </select>
                </div>
                <div class="admin-form-group">
                    <label asp-for="Director" class="admin-label"></label>
                    <input asp-for="Director" class="admin-input" />
                    <span asp-validation-for="Director" class="admin-form-error"></span>
                </div>
            </div>

            <div class="admin-form-group">
                <label asp-for="Cast" class="admin-label"></label>
                <input asp-for="Cast" class="admin-input" placeholder="Diễn viên A, Diễn viên B" />
                <span asp-validation-for="Cast" class="admin-form-error"></span>
            </div>

            <div class="admin-form-group">
                <label asp-for="TrailerUrl" class="admin-label"></label>
                <input asp-for="TrailerUrl" class="admin-input" placeholder="https://www.youtube.com/watch?v=…" />
                <span asp-validation-for="TrailerUrl" class="admin-form-error"></span>
            </div>

            <div class="admin-form-group">
                <label asp-for="Description" class="admin-label"></label>
                <textarea asp-for="Description" rows="5" class="admin-input" placeholder="Tóm tắt nội dung phim…"></textarea>
                <span asp-validation-for="Description" class="admin-form-error"></span>
            </div>

            <div class="admin-form-check">
                <input asp-for="IsActive" class="form-check-input" />
                <label asp-for="IsActive" class="admin-label" style="margin-bottom: 0; cursor: pointer;">Đang chiếu (hiển thị trên trang khách)</label>
            </div>
            <span asp-validation-for="IsActive" class="admin-form-error" style="display:block"></span>
            <p class="admin-form-hint">Bỏ chọn để ẩn phim khỏi trang khách. Toàn bộ suất chiếu và vé cũ vẫn được lưu trữ nguyên vẹn.</p>
        </div>

        <div>
            <div class="admin-poster-preview-card">
                <div class="admin-label" style="margin-bottom: 0.75rem;">Xem trước poster</div>
                <div class="admin-poster-preview">
                    <img src="@poster" alt="Xem trước poster"
                         data-poster-fallback="@MovieCardViewModel.PlaceholderPoster" data-poster-preview />
                </div>
                <p class="admin-form-hint" style="margin-top: 0.75rem;">
                    Tỷ lệ chuẩn 2:3. Hình ảnh tự động cập nhật khi bạn dán URL.
                </p>
            </div>
        </div>
    </div>

    <div class="admin-form-actions">
        <button type="submit" class="cb-btn cb-btn-primary">
            <span>💾</span> Lưu thông tin
        </button>
        <a asp-action="Index" class="cb-btn cb-btn-ghost">Hủy</a>
    </div>
</form>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
    <script>
        (function () {
            var input = document.querySelector('[data-poster-input]');
            var img = document.querySelector('[data-poster-preview]');
            if (!input || !img) return;

            input.addEventListener('change', function () {
                delete img.dataset.posterFallbackApplied;
                img.src = input.value.trim() || img.dataset.posterFallback;
            });
        })();
    </script>
}
