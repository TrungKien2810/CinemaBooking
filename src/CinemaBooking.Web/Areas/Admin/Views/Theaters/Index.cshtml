@model List<TheaterListItem>
@{
    ViewData["Title"] = "Quản lý chi nhánh";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Chi nhánh</h1>
    <a asp-action="Create" class="btn btn-primary">Thêm chi nhánh</a>
</div>

<table class="table table-sm align-middle">
    <thead>
        <tr>
            <th>Tên chi nhánh</th>
            <th>Thành phố</th>
            <th>Địa chỉ</th>
            <th>Số phòng</th>
            <th>Trạng thái</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var t in Model)
        {
            <tr>
                <td>@t.Name</td>
                <td>@t.City</td>
                <td>@t.Address</td>
                <td>@t.RoomCount</td>
                <td>@(t.IsActive ? "Đang hoạt động" : "Đã đóng")</td>
                <td class="text-end">
                    <a asp-controller="Rooms" asp-action="Index" asp-route-theaterId="@t.Id" class="btn btn-sm btn-outline-primary">Phòng</a>
                    <a asp-action="Edit" asp-route-id="@t.Id" class="btn btn-sm btn-outline-secondary">Sửa</a>
                    @if (t.IsActive)
                    {
                        <form asp-action="Delete" asp-route-id="@t.Id" method="post" class="d-inline"
                              onsubmit="return confirm('Đóng chi nhánh này?');">
                            <button type="submit" class="btn btn-sm btn-outline-danger">Đóng</button>
                        </form>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
