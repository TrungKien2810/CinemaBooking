@model TheaterFormModel
@{
    var isEdit = Model.Id is not null;
    ViewData["Title"] = isEdit ? "Sửa chi nhánh" : "Thêm chi nhánh";
}

<div class="admin-page-head">
    <div class="admin-page-title-wrap">
        <a asp-action="Index" class="admin-back-link">← Danh sách chi nhánh</a>
        <h1 class="admin-page-title">@ViewData["Title"]</h1>
        <p class="admin-page-subtitle">Quản lý thông tin địa điểm và tình trạng hoạt động của chi nhánh rạp.</p>
    </div>
</div>

<form asp-action="@(isEdit ? "Edit" : "Create")" asp-route-id="@Model.Id" method="post" class="admin-form admin-form-narrow">
    <div asp-validation-summary="ModelOnly" class="cb-alert cb-alert-danger" style="margin-bottom: 1.5rem;"></div>

    <div class="admin-form-group">
        <label asp-for="Name" class="admin-label"></label>
        <input asp-for="Name" class="admin-input" placeholder="Ví dụ: CinemaBooking Quận 1, CinemaBooking Cầu Giấy..." />
        <span asp-validation-for="Name" class="admin-form-error"></span>
    </div>

    <div class="admin-form-group">
        <label asp-for="City" class="admin-label"></label>
        <input asp-for="City" class="admin-input" placeholder="Ví dụ: TP. Hồ Chí Minh, Hà Nội, Đà Nẵng..." />
        <span asp-validation-for="City" class="admin-form-error"></span>
        <div class="admin-form-hint">
            Khách hàng lọc suất chiếu theo tên thành phố — vui lòng nhập chính xác và đồng nhất với các chi nhánh cùng khu vực.
        </div>
    </div>

    <div class="admin-form-group">
        <label asp-for="Address" class="admin-label"></label>
        <input asp-for="Address" class="admin-input" placeholder="Địa chỉ chi tiết của cụm rạp..." />
        <span asp-validation-for="Address" class="admin-form-error"></span>
    </div>

    <div class="admin-form-check">
        <input asp-for="IsActive" class="form-check-input" />
        <label asp-for="IsActive" class="admin-label" style="margin-bottom: 0; cursor: pointer;">Đang hoạt động</label>
    </div>
    <p class="admin-form-hint">Chi nhánh tạm đóng hoặc ngừng hoạt động vẫn giữ nguyên các phòng chiếu, suất chiếu cũ và đơn vé để phục vụ tra cứu lịch sử.</p>

    <div class="admin-form-actions">
        <button type="submit" class="cb-btn cb-btn-primary">
            <span>💾</span> Lưu chi nhánh
        </button>
        <a asp-action="Index" class="cb-btn cb-btn-ghost">Hủy</a>
    </div>
</form>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
