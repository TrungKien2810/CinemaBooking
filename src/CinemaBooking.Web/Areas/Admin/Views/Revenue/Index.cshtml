@model RevenueDashboardViewModel
@{
    ViewData["Title"] = "Doanh thu";
}

<div class="admin-page-head">
    <div>
        <h1 class="page-title">Doanh thu</h1>
        <p class="cb-muted page-subtitle">Chỉ tính đơn đã xác nhận, theo ngày đặt vé (giờ rạp).</p>
    </div>
    <a asp-action="Breakdown" asp-route-from="@Model.From.ToString("yyyy-MM-dd")" asp-route-to="@Model.To.ToString("yyyy-MM-dd")"
       class="btn btn-outline-secondary">Theo phim &amp; suất chiếu</a>
</div>

<form method="get" class="row g-2 align-items-end mb-3">
    <div class="col-auto">
        <label for="from" class="form-label">Từ ngày</label>
        <input id="from" name="from" type="date" value="@Model.From.ToString("yyyy-MM-dd")" class="form-control" />
    </div>
    <div class="col-auto">
        <label for="to" class="form-label">Đến ngày</label>
        <input id="to" name="to" type="date" value="@Model.To.ToString("yyyy-MM-dd")" class="form-control" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-primary">Xem</button>
    </div>
</form>

<div class="admin-stat-grid">
    <div class="admin-stat">
        <span class="admin-stat-label">Tổng doanh thu</span>
        <strong class="admin-stat-value is-accent">@Model.TotalRevenue.ToString("N0") ₫</strong>
    </div>
    <div class="admin-stat">
        <span class="admin-stat-label">Vé đã bán</span>
        <strong class="admin-stat-value">@Model.TotalTickets</strong>
    </div>
    <div class="admin-stat">
        <span class="admin-stat-label">Chi nhánh có doanh thu</span>
        <strong class="admin-stat-value">@Model.ByTheater.Count</strong>
    </div>
</div>

<h2 class="h5">Theo chi nhánh</h2>
<div class="table-responsive"><table class="table table-sm align-middle mb-4">
    <thead>
        <tr>
            <th>Chi nhánh</th>
            <th class="text-end">Vé</th>
            <th class="text-end">Doanh thu</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var t in Model.ByTheater)
        {
            <tr>
                <td>@t.TheaterName</td>
                <td class="text-end">@t.Tickets</td>
                <td class="text-end">@t.Revenue.ToString("N0")</td>
            </tr>
        }
        @if (Model.ByTheater.Count == 0)
        {
            <tr><td colspan="3" class="text-center text-muted">Chưa có vé nào được bán trong khoảng này.</td></tr>
        }
    </tbody>
</table></div>

<h2 class="h5">Theo ngày</h2>
<div class="table-responsive"><table class="table table-sm align-middle">
    <thead>
        <tr>
            <th>Ngày</th>
            <th>Chi nhánh</th>
            <th class="text-end">Vé</th>
            <th class="text-end">Doanh thu</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var r in Model.ByDay)
        {
            <tr>
                <td>@r.Day.ToString("dd/MM/yyyy")</td>
                <td>@r.TheaterName</td>
                <td class="text-end">@r.Tickets</td>
                <td class="text-end">@r.Revenue.ToString("N0")</td>
            </tr>
        }
    </tbody>
</table></div>
