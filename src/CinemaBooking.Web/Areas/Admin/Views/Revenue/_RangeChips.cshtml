@model RangeChipsModel
@{
    var today = Model.Today;
    var firstOfMonth = new DateOnly(today.Year, today.Month, 1);
    var presets = new (string Label, DateOnly From, DateOnly To)[]
    {
        ("Hôm nay", today, today),
        ("Hôm qua", today.AddDays(-1), today.AddDays(-1)),
        ("7 ngày", today.AddDays(-6), today),
        ("30 ngày", today.AddDays(-29), today),
        ("90 ngày", today.AddDays(-89), today),
        ("Tháng này", firstOfMonth, today),
        ("Tháng trước", firstOfMonth.AddMonths(-1), firstOfMonth.AddDays(-1)),
        ("Năm nay", new DateOnly(today.Year, 1, 1), today),
    };
}
@* Nút chọn nhanh khoảng thời gian: bấm là xem luôn, giữ nguyên chi nhánh đang lọc (nếu có). *@
<nav class="range-chips" aria-label="Chọn nhanh khoảng thời gian">
    @foreach (var p in presets)
    {
        var isCurrent = p.From == Model.From && p.To == Model.To;
        <a asp-action="@Model.Action" asp-route-from="@p.From.ToString("yyyy-MM-dd")" asp-route-to="@p.To.ToString("yyyy-MM-dd")"
           asp-route-theaterId="@Model.TheaterId" class="range-chip @(isCurrent ? "active" : null)"
           aria-current="@(isCurrent ? "true" : null)">@p.Label</a>
    }
</nav>
