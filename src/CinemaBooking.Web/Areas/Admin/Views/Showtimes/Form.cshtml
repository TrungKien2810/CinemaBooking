@model ShowtimeFormModel
@{
    var isEdit = Model.Id is not null;
    ViewData["Title"] = isEdit ? "Sửa suất chiếu" : "Thêm suất chiếu";
}

<div class="admin-page-head">
    <div class="admin-page-title-wrap">
        <a asp-action="Index" class="admin-back-link">← Danh sách suất chiếu</a>
        <h1 class="admin-page-title">@ViewData["Title"]</h1>
        <p class="admin-page-subtitle">Xếp lịch và ấn định giá vé cơ bản cho suất chiếu.</p>
    </div>
</div>

<form asp-action="@(isEdit ? "Edit" : "Create")" asp-route-id="@Model.Id" method="post" class="admin-form admin-form-narrow">
    <div asp-validation-summary="ModelOnly" class="cb-alert cb-alert-danger" style="margin-bottom: 1.5rem;"></div>

    <div class="admin-form-group">
        <label asp-for="MovieId" class="admin-label"></label>
        <select asp-for="MovieId" asp-items="Model.Movies" class="admin-input">
            <option value="0">— Chọn phim —</option>
        </select>
        <span asp-validation-for="MovieId" class="admin-form-error"></span>
    </div>

    <div class="admin-form-group">
        <label asp-for="RoomId" class="admin-label"></label>
        <select asp-for="RoomId" asp-items="Model.Rooms" class="admin-input">
            <option value="0">— Chọn phòng chiếu —</option>
        </select>
        <span asp-validation-for="RoomId" class="admin-form-error"></span>
    </div>

    <div class="admin-form-grid admin-form-grid-2">
        <div class="admin-form-group">
            <label asp-for="StartTimeLocal" class="admin-label"></label>
            <input asp-for="StartTimeLocal" type="datetime-local" class="admin-input" />
            <span asp-validation-for="StartTimeLocal" class="admin-form-error"></span>
        </div>
        <div class="admin-form-group">
            <label asp-for="BasePrice" class="admin-label"></label>
            <input asp-for="BasePrice" class="admin-input" type="number" step="1000" min="0" placeholder="VNĐ" />
            <span asp-validation-for="BasePrice" class="admin-form-error"></span>
        </div>
    </div>

    <ul class="admin-hints">
        <li>Giờ nhập theo giờ rạp; giờ kết thúc được hệ thống tự tính dựa trên thời lượng phim.</li>
        <li>Hai suất chiếu trong cùng một phòng phải cách nhau tối thiểu @CinemaBooking.Web.Areas.Admin.Controllers.ShowtimesController.CleaningBuffer.TotalMinutes phút để dọn dẹp vệ sinh.</li>
        <li>Giá vé cơ bản là giá cho ghế Thường; ghế VIP và ghế đôi sẽ áp dụng hệ số phụ thu tự động.</li>
    </ul>

    <div class="admin-form-actions">
        <button type="submit" class="cb-btn cb-btn-primary">
            <span>💾</span> Lưu suất chiếu
        </button>
        <a asp-action="Index" class="cb-btn cb-btn-ghost">Hủy</a>
    </div>
</form>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
