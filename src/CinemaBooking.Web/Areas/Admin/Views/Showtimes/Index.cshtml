@model ShowtimesIndexViewModel
@{
    ViewData["Title"] = "Quản lý suất chiếu";
    // Controller đã sắp theo chi nhánh rồi giờ chiếu.
    var byTheater = Model.Items.GroupBy(s => s.TheaterName).ToList();

    string DayLink(DateOnly d) => Url.Action("Index", new { date = d.ToString("yyyy-MM-dd"), theaterId = Model.TheaterId, movieId = Model.MovieId, status = Model.Status })!;
}

<div class="admin-page-head">
    <div>
        <h1 class="page-title">Suất chiếu</h1>
        <p class="cb-muted page-subtitle">
            Ngày @Model.Date.ToString("dd/MM/yyyy") · @Model.Items.Count suất ở @byTheater.Count chi nhánh
        </p>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <a asp-action="AutoPlan" asp-route-theaterId="@Model.TheaterId" asp-route-date="@Model.Date.ToString("yyyy-MM-dd")"
           class="btn btn-outline-primary">Gợi ý lịch cả ngày</a>
        <a asp-action="Create" class="btn btn-primary">Thêm suất chiếu</a>
    </div>
</div>

<form method="get" class="cb-card admin-filter">
    <div class="btn-group" role="group" aria-label="Chuyển ngày">
        <a href="@DayLink(Model.Date.AddDays(-1))" class="btn btn-outline-secondary" aria-label="Ngày trước">‹</a>
        <a href="@Url.Action("Index", new { theaterId = Model.TheaterId })" class="btn btn-outline-secondary">Hôm nay</a>
        <a href="@DayLink(Model.Date.AddDays(1))" class="btn btn-outline-secondary" aria-label="Ngày sau">›</a>
    </div>
    <div>
        <label for="date" class="visually-hidden">Ngày</label>
        <input id="date" name="date" type="date" value="@Model.Date.ToString("yyyy-MM-dd")" class="form-control" />
    </div>
    <div>
        <label for="theaterId" class="visually-hidden">Chi nhánh</label>
        <select id="theaterId" name="theaterId" class="form-select"
                asp-items="@(new SelectList(Model.Theaters, "Value", "Text", Model.TheaterId))">
            <option value="">Tất cả chi nhánh</option>
        </select>
    </div>
    <div>
        <label for="movieId" class="visually-hidden">Phim</label>
        <select id="movieId" name="movieId" class="form-select" style="max-width:16rem"
                asp-items="@(new SelectList(Model.Movies ?? new List<SelectListItem>(), "Value", "Text", Model.MovieId))">
            <option value="">Mọi phim</option>
        </select>
    </div>
    <div>
        <label for="status" class="visually-hidden">Trạng thái</label>
        <select id="status" name="status" class="form-select">
            <option value="">Mọi trạng thái</option>
            <option value="active" selected="@(Model.Status == "active")">Đang bán</option>
            <option value="hidden" selected="@(Model.Status == "hidden")">Đang ẩn</option>
        </select>
    </div>
    <button type="submit" class="btn btn-outline-primary">Lọc</button>
</form>

@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger">@error</div>
}
@if (TempData["Message"] is string msg)
{
    <div class="alert alert-success">@msg</div>
}

<form asp-action="CopyDay" method="post" class="cb-card admin-filter">
    <input type="hidden" name="sourceDate" value="@Model.Date.ToString("yyyy-MM-dd")" />
    <input type="hidden" name="theaterId" value="@Model.TheaterId" />
    <label for="targetDate" class="mb-0">Sao chép lịch ngày @Model.Date.ToString("dd/MM") sang</label>
    <input id="targetDate" name="targetDate" type="date" required value="@Model.Date.AddDays(1).ToString("yyyy-MM-dd")" class="form-control" style="max-width:11rem" />
    <button type="submit" class="btn btn-outline-primary">Sao chép</button>
</form>

@if (Model.Items.Count == 0)
{
    <div class="cb-card empty-state">
        <p class="empty-title">Không có suất chiếu nào trong ngày này</p>
        <p class="cb-muted">Chọn ngày khác hoặc thêm suất chiếu mới.</p>
    </div>
}
else
{
    <div class="cb-card admin-table-wrap">
        <table class="table admin-table align-middle mb-0">
            <thead>
                <tr>
                    <th>Giờ chiếu</th>
                    <th>Phim</th>
                    <th>Phòng</th>
                    <th class="text-end">Giá vé</th>
                    <th class="text-end">Đơn</th>
                    <th></th>
                </tr>
            </thead>
            @foreach (var theater in byTheater)
            {
                <tbody>
                    <tr class="admin-group-row">
                        <th colspan="6" scope="rowgroup">@theater.Key <span class="cb-muted fw-normal">· @theater.Count() suất</span></th>
                    </tr>
                    @foreach (var s in theater)
                    {
                        <tr>
                            <td class="text-nowrap">
                                <span class="fw-semibold">@s.StartLocal.ToString("HH:mm")</span>
                                <span class="cb-muted">– @s.EndLocal.ToString("HH:mm")</span>
                            </td>
                            <td>@s.MovieTitle@if (!s.IsActive) { <span class="badge text-bg-secondary ms-1">Đang ẩn</span> }</td>
                            <td class="text-nowrap">@s.RoomName <span class="badge text-bg-light">@s.RoomType.Label()</span> <span class="badge text-bg-light">@s.Language.Label()</span></td>
                            <td class="text-end text-nowrap">@s.BasePrice.Vnd()</td>
                            <td class="text-end">@s.BookingCount</td>
                            <td class="admin-actions">
                                <a asp-action="Edit" asp-route-id="@s.Id" class="btn btn-sm btn-outline-secondary">Sửa</a>
                                <form asp-action="ToggleActive" asp-route-id="@s.Id" method="post" class="d-inline">
                                    <button type="submit" class="btn btn-sm btn-outline-secondary">@(s.IsActive ? "Ẩn" : "Hiện")</button>
                                </form>
                                @if (s.BookingCount == 0)
                                {
                                    <form asp-action="Delete" asp-route-id="@s.Id" method="post" class="d-inline"
                                          data-confirm="Xóa suất @s.StartLocal.ToString("HH:mm") “@s.MovieTitle” ở @s.TheaterName?">
                                        <button type="submit" class="btn btn-sm btn-outline-danger">Xóa</button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            }
        </table>
    </div>
}
