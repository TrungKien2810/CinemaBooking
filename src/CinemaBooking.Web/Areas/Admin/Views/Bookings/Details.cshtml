@model BookingDetailsViewModel
@{
    ViewData["Title"] = "Đơn " + Model.BookingCode;
}

<div class="admin-page-head">
    <div>
        <a asp-action="Index" class="back-link">← Danh sách đơn</a>
        <h1 class="page-title">Đơn @Model.BookingCode <span class="badge bg-secondary">@Model.Status.Label()</span></h1>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary">Về danh sách</a>
</div>

@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger">@error</div>
}
@if (TempData["Message"] is string message)
{
    <div class="alert alert-success">@message</div>
}

<dl class="row">
    <dt class="col-sm-3">Đặt lúc</dt>
    <dd class="col-sm-9">@Model.BookedLocal.ToString("dd/MM/yyyy HH:mm")</dd>
    <dt class="col-sm-3">Khách hàng</dt>
    <dd class="col-sm-9">@Model.CustomerName · @Model.CustomerEmail @(Model.CustomerPhone is null ? "" : "· " + Model.CustomerPhone)</dd>
    <dt class="col-sm-3">Phim</dt>
    <dd class="col-sm-9">@Model.MovieTitle</dd>
    <dt class="col-sm-3">Suất chiếu</dt>
    <dd class="col-sm-9">@Model.ShowtimeStartLocal.ToString("dd/MM/yyyy HH:mm") · @Model.TheaterName · @Model.RoomName</dd>
    <dt class="col-sm-3">Thanh toán</dt>
    <dd class="col-sm-9">@(Model.PaymentStatus?.Label() ?? "Chưa có") @(Model.TransactionId is null ? "" : "· " + Model.TransactionId)</dd>
    @if (Model.CheckedInLocal is { } checkedIn)
    {
        <dt class="col-sm-3">Soát vé</dt>
        <dd class="col-sm-9">Đã vào rạp lúc @checkedIn.ToString("HH:mm dd/MM/yyyy")</dd>
    }
</dl>

<h2 class="h5">Ghế</h2>
<div class="table-responsive"><table class="table table-sm align-middle">
    <thead>
        <tr>
            <th>Ghế</th>
            <th>Loại</th>
            <th class="text-end">Giá lúc đặt</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var s in Model.Seats)
        {
            <tr>
                <td>@s.Label</td>
                <td>@s.SeatType.Label()</td>
                <td class="text-end">@s.Price.Vnd()</td>
            </tr>
        }
        @if (Model.Seats.Count == 0)
        {
            <tr><td colspan="3" class="text-center text-muted">Đơn không còn giữ ghế nào (đã hủy hoặc thanh toán quá hạn).</td></tr>
        }
    </tbody>
    <tfoot>
        @if (Model.VoucherCode is not null && Model.VoucherDiscount > 0)
        {
            <tr>
                <td colspan="2">Mã giảm giá <strong>@Model.VoucherCode</strong></td>
                <td class="text-end text-success">−@Model.VoucherDiscount.Vnd()</td>
            </tr>
        }
        <tr>
            <th colspan="2">Tổng tiền</th>
            <th class="text-end">@Model.TotalAmount.Vnd()</th>
        </tr>
    </tfoot>
</table></div>

@if (Model.PaymentStatus == PaymentStatus.RefundPending)
{
    <form asp-action="MarkRefunded" asp-route-id="@Model.Id" method="post" class="cb-card admin-form mt-3"
          data-confirm="Xác nhận đã chuyển trả @Model.TotalAmount.Vnd() cho khách?">
        <h2 class="h5">Hoàn tiền</h2>
        <p class="form-text">Đơn đã hủy, rạp cần hoàn @Model.TotalAmount.Vnd() cho khách. Chuyển tiền xong thì bấm nút dưới đây.</p>
        <button type="submit" class="btn btn-primary">Đánh dấu đã hoàn tiền</button>
    </form>
}

@if (Model.CancelBlockedReason is null)
{
    <form asp-action="Cancel" asp-route-id="@Model.Id" method="post" class="cb-card admin-form mt-3"
          data-confirm="Hủy vé @Model.BookingCode? Khách nhận email, ghế được trả lại và rạp phải hoàn tiền. Không hoàn tác được.">
        <h2 class="h5">Rạp hủy vé</h2>
        <p class="form-text">Chỉ dùng khi lỗi ở phía rạp. Khách không tự hủy được vé đã mua.</p>
        <div class="mb-3">
            <label for="cancel-reason" class="form-label">Lý do gửi cho khách</label>
            <input id="cancel-reason" name="reason" class="form-control" maxlength="300" required
                   placeholder="Ví dụ: Phòng chiếu gặp sự cố kỹ thuật" />
        </div>
        <button type="submit" class="btn btn-outline-danger">Hủy vé và hoàn tiền</button>
    </form>
}
