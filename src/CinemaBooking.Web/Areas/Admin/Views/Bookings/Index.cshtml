@using CinemaBooking.Domain.Enums
@model BookingsIndexViewModel
@{
    ViewData["Title"] = "Quản lý đơn đặt vé";
}

<div class="admin-page-head">
    <div>
        <h1 class="page-title">Đơn đặt vé</h1>
        <p class="cb-muted page-subtitle">
            Tra cứu theo mã đơn, tên, email hoặc số điện thoại; lọc theo chi nhánh, trạng thái và ngày đặt.
            @if (Model.Paging is { } p0) { <text>· @p0.Total đơn</text> }
        </p>
    </div>
</div>

<form method="get" class="admin-filter-grid">
    <div class="col-auto">
        <label for="q" class="form-label">Tìm đơn</label>
        <input id="q" name="q" value="@Model.Query" type="search" class="form-control" style="min-width:15rem"
               placeholder="Mã đơn, tên, email, SĐT…" maxlength="100" />
    </div>
    <div class="col-auto">
        <label for="from" class="form-label">Đặt từ ngày</label>
        <input id="from" name="from" type="date" value="@Model.From?.ToString("yyyy-MM-dd")" class="form-control" />
    </div>
    <div class="col-auto">
        <label for="to" class="form-label">Đến ngày</label>
        <input id="to" name="to" type="date" value="@Model.To?.ToString("yyyy-MM-dd")" class="form-control" />
    </div>
    @if (!User.IsInRole(AppRoles.BranchAdmin))
    {

        <div class="col-auto">
        <label for="theaterId" class="form-label">Chi nhánh</label>
        <select id="theaterId" name="theaterId" class="form-select"
                asp-items="@(new SelectList(Model.Theaters, "Value", "Text", Model.TheaterId))">
            <option value="">Tất cả chi nhánh</option>
        </select>
    </div>

    }
    <div class="col-auto">
        <label for="status" class="form-label">Trạng thái</label>
        <select id="status" name="status" class="form-select">
            <option value="">Mọi trạng thái</option>
            @foreach (var s in Enum.GetValues<BookingStatus>())
            {
                <option value="@s" selected="@(s == Model.Status)">@s.Label()</option>
            }
        </select>
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-primary">Lọc</button>
        @if (Model.IsFiltered) { <a asp-action="Index" class="btn btn-link">Xóa lọc</a> }
    </div>
</form>

<div class="table-responsive"><table class="table table-sm align-middle">
    <thead>
        <tr>
            <th>Mã đơn</th>
            <th>Khách hàng</th>
            <th>Phim</th>
            <th>Chi nhánh</th>
            <th>Suất chiếu</th>
            <th>Đặt lúc</th>
            <th class="text-end">Số ghế</th>
            <th class="text-end">Tổng tiền</th>
            <th>Trạng thái</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var b in Model.Items)
        {
            <tr>
                <td><a asp-action="Details" asp-route-id="@b.Id" class="code-link">@b.BookingCode</a></td>
                <td>@b.CustomerName</td>
                <td>@b.MovieTitle</td>
                <td>@b.TheaterName</td>
                <td>@b.ShowtimeStartLocal.ToString("dd/MM HH:mm")</td>
                <td>@b.BookedLocal.ToString("dd/MM HH:mm")</td>
                <td class="text-end">@b.SeatCount</td>
                <td class="text-end">@b.TotalAmount.Vnd()</td>
                <td>@b.Status.Label()</td>
            </tr>
        }
        @if (Model.Items.Count == 0)
        {
            <tr><td colspan="9" class="text-center text-muted">Không có đơn nào khớp bộ lọc.</td></tr>
        }
    </tbody>
</table></div>

@if (Model.Paging is { } paging)
{
    var route = new Dictionary<string, object?>
    {
        ["q"] = Model.Query, ["theaterId"] = Model.TheaterId, ["status"] = Model.Status,
        ["from"] = Model.From?.ToString("yyyy-MM-dd"), ["to"] = Model.To?.ToString("yyyy-MM-dd"),
    };
    @await Html.PartialAsync("_Pager", new PagerModel("Index", paging, route))
}
