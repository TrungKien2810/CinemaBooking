@model RoomSeatsViewModel
@{
    ViewData["Title"] = "Sửa loại ghế — " + Model.RoomName;

    static string CssFor(SeatType t) => t switch
    {
        SeatType.Vip => "seat-vip",
        SeatType.Couple => "seat-couple",
        _ => "seat-standard",
    };
}

<div class="admin-page-head">
    <div class="admin-page-title-wrap">
        <a asp-action="Index" asp-route-theaterId="@Model.TheaterId" class="admin-back-link">
            ← Phòng chiếu · @Model.TheaterName
        </a>
        <h1 class="admin-page-title">Sửa loại ghế · @Model.RoomName</h1>
        <p class="admin-page-subtitle">
            @Model.TotalRows hàng × @Model.TotalColumns ghế · Bấm vào ghế bất kỳ để chuyển đổi giữa <strong>Thường ↔ VIP</strong>.
            Hàng cuối (@(Model.Rows.Count > 0 ? Model.Rows[^1].Label : "?")) được cố định là <strong>ghế đôi</strong> theo thiết kế rạp.
        </p>
    </div>
</div>

@if (TempData["Message"] is string message)
{
    <div class="cb-alert cb-alert-success">
        <span>✓</span>
        <span>@message</span>
    </div>
}
@if (TempData["Error"] is string error)
{
    <div class="cb-alert cb-alert-danger">
        <span>⚠️</span>
        <span>@error</span>
    </div>
}

<form asp-action="Seats" asp-route-id="@Model.RoomId" method="post" class="admin-form">
    <input type="hidden" name="types" id="seat-types" value="" />

    <div class="seat-preview" style="padding: 1.5rem 1rem;">
        <div class="seat-screen" aria-hidden="true">Màn hình</div>

        <div class="seat-preview-scroll">
            <div class="seat-preview-grid room-seat-editor" style="--seat-cols: @Model.TotalColumns"
                 aria-label="Sơ đồ ghế @Model.RoomName">
                @foreach (var row in Model.Rows)
                {
                    <span class="seat-row-label">@row.Label</span>
                    @foreach (var seat in row.Seats)
                    {
                        if (row.IsCoupleRow)
                        {
                            <span class="seat-dot seat-couple seat-locked"
                                  title="Ghế đôi @seat.Label — tự động ở hàng cuối"
                                  aria-label="Ghế đôi @seat.Label, tự động ở hàng cuối"></span>
                        }
                        else
                        {
                            <button type="button"
                                    class="seat-dot @CssFor(seat.Type) seat-editable"
                                    data-seat-id="@seat.SeatId"
                                    data-seat-label="@seat.Label"
                                    data-type="@seat.Type"
                                    aria-pressed="@(seat.Type == SeatType.Vip ? "true" : "false")"
                                    aria-label="Ghế @seat.Label, @seat.Type — bấm để đổi Thường hoặc VIP"
                                    title="Ghế @seat.Label · @seat.Type"></button>
                        }
                    }
                }
            </div>
        </div>

        <ul class="seat-legend" style="margin-top: 1rem;">
            <li><span class="seat-dot seat-standard"></span> Thường · <strong id="count-standard">@Model.StandardCount</strong></li>
            <li><span class="seat-dot seat-vip"></span> VIP · <strong id="count-vip" style="color: var(--cb-seat-vip);">@Model.VipCount</strong></li>
            <li><span class="seat-dot seat-couple"></span> Ghế đôi (hàng cuối) · <strong>@Model.CoupleCount</strong></li>
            <li style="color: var(--cb-text-faint);">Tổng @(Model.TotalRows * Model.TotalColumns) ghế</li>
        </ul>
    </div>

    <div class="admin-form-actions">
        <button type="submit" class="cb-btn cb-btn-primary">
            <span>💾</span> Lưu cấu hình loại ghế
        </button>
        <a asp-action="Index" asp-route-theaterId="@Model.TheaterId" class="cb-btn cb-btn-ghost">Hủy</a>
    </div>
</form>

@section Scripts {
    <script>
        (function () {
            var buttons = Array.prototype.slice.call(document.querySelectorAll('.seat-editable'));
            var input = document.getElementById('seat-types');
            var vipCount = document.getElementById('count-vip');
            var standardCount = document.getElementById('count-standard');

            function serialize() {
                return buttons.map(function (b) {
                    return b.dataset.seatId + '=' + b.dataset.type;
                }).join(';');
            }

            function refreshCounts() {
                var vip = buttons.filter(function (b) { return b.dataset.type === 'Vip'; }).length;
                if (vipCount) vipCount.textContent = vip;
                if (standardCount) standardCount.textContent = buttons.length - vip;
            }

            buttons.forEach(function (btn) {
                btn.addEventListener('click', function () {
                    btn.dataset.type = btn.dataset.type === 'Vip' ? 'Standard' : 'Vip';
                    btn.classList.toggle('seat-vip', btn.dataset.type === 'Vip');
                    btn.classList.toggle('seat-standard', btn.dataset.type !== 'Vip');
                    btn.setAttribute('aria-pressed', btn.dataset.type === 'Vip' ? 'true' : 'false');
                    btn.title = 'Ghế ' + btn.dataset.seatLabel + ' · ' + btn.dataset.type;
                    input.value = serialize();
                    refreshCounts();
                });
            });

            input.value = serialize();
        })();
    </script>
}
