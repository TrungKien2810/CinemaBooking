@model RoomsIndexViewModel
@{
    ViewData["Title"] = $"Phòng chiếu — {Model.TheaterName}";
}

<div class="admin-page-head">
    <div>
        @if (User.IsInRole(AppRoles.Admin))
        {
            <a asp-controller="Theaters" asp-action="Index" class="back-link">← Danh sách chi nhánh</a>
        }
        <h1 class="page-title">Phòng chiếu · @Model.TheaterName</h1>
        <p class="cb-muted page-subtitle">@Model.Rooms.Count phòng · @Model.Rooms.Sum(r => r.SeatCount) ghế</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-controller="Promotions" asp-action="Index" asp-route-theaterId="@Model.TheaterId" class="btn btn-outline-secondary">Khuyến mãi</a>
        <a asp-action="Create" asp-route-theaterId="@Model.TheaterId" class="btn btn-primary">Thêm phòng</a>
    </div>
</div>

@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger">@error</div>
}
@if (TempData["Message"] is string message)
{
    <div class="alert alert-success" role="status">@message</div>
}

@if (Model.Rooms.Count == 0)
{
    <div class="cb-card empty-state">
        <p class="empty-title">Chi nhánh chưa có phòng chiếu</p>
        <p class="cb-muted">Thêm phòng và nhập số hàng × số ghế — sơ đồ ghế được sinh tự động.</p>
    </div>
}
else
{
    <div class="cb-card admin-table-wrap">
        <table class="table admin-table align-middle mb-0">
            <thead>
                <tr>
                    <th>Phòng</th>
                    <th>Loại</th>
                    <th>Sơ đồ</th>
                    <th class="text-end">Số ghế</th>
                    <th class="text-end">Suất chiếu</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in Model.Rooms)
                {
                    <tr>
                        <td class="fw-semibold">@r.RoomName</td>
                        <td><span class="badge text-bg-light">@r.RoomType.Label()</span></td>
                        <td class="text-nowrap">@r.TotalRows hàng × @r.TotalColumns ghế</td>
                        <td class="text-end">@r.SeatCount</td>
                        <td class="text-end">@r.ShowtimeCount</td>
                        <td class="admin-actions">
                            <a asp-action="Seats" asp-route-id="@r.Id" class="btn btn-sm btn-outline-primary">Sửa ghế</a>
                            <a asp-action="Edit" asp-route-id="@r.Id" class="btn btn-sm btn-outline-secondary">Sửa phòng</a>
                            @if (r.ShowtimeCount == 0)
                            {
                                <form asp-action="Delete" asp-route-id="@r.Id" method="post" class="d-inline"
                                      data-confirm="Xóa phòng “@r.RoomName” và toàn bộ ghế?">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Xóa</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
