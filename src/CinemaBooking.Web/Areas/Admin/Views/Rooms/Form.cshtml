@model RoomFormModel
@{
    var isEdit = Model.Id is not null;
    ViewData["Title"] = (isEdit ? "Sửa phòng" : "Thêm phòng") + " — " + Model.TheaterName;
}

<div class="admin-page-head">
    <div>
        <a asp-action="Index" asp-route-theaterId="@Model.TheaterId" class="admin-back">← Phòng chiếu · @Model.TheaterName</a>
        <h1 class="page-title">@(isEdit ? "Sửa phòng" : "Thêm phòng")</h1>
    </div>
</div>

<form asp-action="@(isEdit ? "Edit" : "Create")" asp-route-id="@Model.Id" method="post" class="cb-card admin-form">
    <div asp-validation-summary="ModelOnly"></div>
    <input asp-for="TheaterId" type="hidden" />

    <div class="row g-4">
        <div class="col-lg-5">
            <div class="mb-3">
                <label asp-for="RoomName" class="form-label"></label>
                <input asp-for="RoomName" class="form-control" placeholder="Phòng 1" />
                <span asp-validation-for="RoomName" class="text-danger small"></span>
            </div>
            <div class="row">
                <div class="col mb-3">
                    <label asp-for="TotalRows" class="form-label"></label>
                    <input asp-for="TotalRows" class="form-control" />
                    <span asp-validation-for="TotalRows" class="text-danger small"></span>
                </div>
                <div class="col mb-3">
                    <label asp-for="TotalColumns" class="form-label"></label>
                    <input asp-for="TotalColumns" class="form-control" />
                    <span asp-validation-for="TotalColumns" class="text-danger small"></span>
                </div>
            </div>
            <p class="form-text">
                Ghế được sinh tự động theo số hàng × số ghế mỗi hàng.
                @if (isEdit)
                {
                    <text>Đổi số hàng hoặc số ghế sẽ sinh lại toàn bộ sơ đồ — chỉ làm được khi phòng chưa có vé nào được đặt.</text>
                }
            </p>
        </div>
    </div>

    <div class="admin-form-actions">
        <button type="submit" class="btn btn-primary">Lưu</button>
        <a asp-action="Index" asp-route-theaterId="@Model.TheaterId" class="btn btn-link">Hủy</a>
    </div>
</form>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
