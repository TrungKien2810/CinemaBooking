@model RoomFormModel
@{
    var isEdit = Model.Id is not null;
    ViewData["Title"] = (isEdit ? "Sửa phòng" : "Thêm phòng") + " — " + Model.TheaterName;
}

<div class="admin-page-head">
    <div class="admin-page-title-wrap">
        <a asp-action="Index" asp-route-theaterId="@Model.TheaterId" class="admin-back-link">
            ← Phòng chiếu · @Model.TheaterName
        </a>
        <h1 class="admin-page-title">@(isEdit ? "Sửa phòng" : "Thêm phòng mới")</h1>
        <p class="admin-page-subtitle">Thiết lập quy cách hàng và cột ghế cho phòng chiếu tại @Model.TheaterName.</p>
    </div>
</div>

<form asp-action="@(isEdit ? "Edit" : "Create")" asp-route-id="@Model.Id" method="post" class="admin-form">
    <div asp-validation-summary="ModelOnly" class="cb-alert cb-alert-danger" style="margin-bottom: 1.5rem;"></div>
    <input asp-for="TheaterId" type="hidden" />

    <div class="admin-form-layout-room">
        <div>
            <div class="admin-form-group">
                <label asp-for="RoomName" class="admin-label"></label>
                <input asp-for="RoomName" class="admin-input" placeholder="Ví dụ: Phòng 1, IMAX Laser..." />
                <span asp-validation-for="RoomName" class="admin-form-error"></span>
            </div>

            <div class="admin-form-grid admin-form-grid-2">
                <div class="admin-form-group">
                    <label asp-for="TotalRows" class="admin-label"></label>
                    <input asp-for="TotalRows" class="admin-input" type="number" min="1" max="26" />
                    <span asp-validation-for="TotalRows" class="admin-form-error"></span>
                </div>
                <div class="admin-form-group">
                    <label asp-for="TotalColumns" class="admin-label"></label>
                    <input asp-for="TotalColumns" class="admin-input" type="number" min="1" max="40" />
                    <span asp-validation-for="TotalColumns" class="admin-form-error"></span>
                </div>
            </div>

            <div class="admin-form-hint" style="margin-top: 0.5rem; line-height: 1.6;">
                <p>Ghế được sinh tự động theo quy tắc: Hàng A, B, C... từ trên xuống dưới màn hình.</p>
                @if (isEdit)
                {
                    <p style="color: var(--cb-warning);">
                        ⚠️ Thay đổi số hàng hoặc số cột sẽ tạo lại toàn bộ sơ đồ ghế — chỉ cho phép khi phòng chưa phát sinh đơn vé nào.
                    </p>
                }
            </div>
        </div>

        <div>
            <div class="admin-poster-preview-card" style="text-align: left;">
                <div class="admin-label" style="margin-bottom: 0.75rem;">Xem trước sơ đồ phòng</div>
                <div data-seat-preview data-url="@Url.Action("SeatPreview")" aria-live="polite">
                    <partial name="_SeatPreview" model="SeatPreviewModel.For(Model.TotalRows, Model.TotalColumns)" />
                </div>
            </div>
        </div>
    </div>

    <div class="admin-form-actions">
        <button type="submit" class="cb-btn cb-btn-primary">
            <span>💾</span> Lưu phòng chiếu
        </button>
        <a asp-action="Index" asp-route-theaterId="@Model.TheaterId" class="cb-btn cb-btn-ghost">Hủy</a>
    </div>
</form>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
    <script>
        (function () {
            var box = document.querySelector('[data-seat-preview]');
            var rows = document.getElementById('@Html.IdFor(m => m.TotalRows)');
            var cols = document.getElementById('@Html.IdFor(m => m.TotalColumns)');
            if (!box || !rows || !cols) return;

            var timer, latest = 0;

            function refresh() {
                var r = parseInt(rows.value, 10), c = parseInt(cols.value, 10);
                if (!(r > 0) || !(c > 0)) return;

                var ticket = ++latest;
                var url = box.dataset.url + '?rows=' + r + '&columns=' + c;
                fetch(url, { headers: { 'X-Requested-With': 'fetch' } })
                    .then(function (res) { return res.ok ? res.text() : Promise.reject(res.status); })
                    .then(function (html) { if (ticket === latest) box.innerHTML = html; })
                    .catch(function () { });
            }

            [rows, cols].forEach(function (input) {
                input.addEventListener('input', function () {
                    clearTimeout(timer);
                    timer = setTimeout(refresh, 250);
                });
            });
        })();
    </script>
}
