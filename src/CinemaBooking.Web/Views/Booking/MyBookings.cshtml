@model MyBookingsViewModel
@using CinemaBooking.Domain.Enums
@{
    ViewData["Title"] = "Vé của tôi";

    string TabClass(string tab) =>
        string.Equals(Model.Tab, tab, StringComparison.OrdinalIgnoreCase) ? "cr-chip is-active" : "cr-chip";
    string Current(string tab) =>
        string.Equals(Model.Tab, tab, StringComparison.OrdinalIgnoreCase) ? "true" : null!;
}

<section class="cr-card">
    <small>Lịch sử đặt vé</small>
    <h1 class="cb-page-title">Vé của tôi</h1>
</section>

@if (TempData["Success"] is string success)
{
    <div class="cb-alert cb-alert-success" role="status"><span>@success</span></div>
}
@if (TempData["Error"] is string error)
{
    <div class="cb-alert cb-alert-danger" role="alert"><span>@error</span></div>
}

<nav class="cr-chips" aria-label="Bộ lọc vé">
    <a class="@TabClass("all")" asp-action="MyBookings" asp-route-tab="all" aria-current="@Current("all")">Tất cả (@Model.AllCount)</a>
    <a class="@TabClass("upcoming")" asp-action="MyBookings" asp-route-tab="upcoming" aria-current="@Current("upcoming")">Sắp chiếu (@Model.UpcomingCount)</a>
    <a class="@TabClass("history")" asp-action="MyBookings" asp-route-tab="history" aria-current="@Current("history")">Đã xem (@Model.HistoryCount)</a>
</nav>

@if (Model.Bookings.Count == 0)
{
    <div class="cr-empty">
        <p class="cr-empty-title">Không có vé trong mục này</p>
        <p>Chọn một phim đang chiếu và giữ ghế để đơn đặt vé xuất hiện ở đây.</p>
        <a asp-controller="Home" asp-action="Index" class="cb-btn cb-btn-primary">Xem phim đang chiếu</a>
    </div>
}
else
{
    <div class="cr-stubs">
        @foreach (var booking in Model.Bookings)
        {
            <article class="cr-stub">
                <div class="cr-stub-when">
                    <span class="cr-stub-day">@booking.StartLocal.ToString("dd/MM")</span>
                    <span class="cr-stub-time">@booking.StartLocal.ToString("HH:mm")</span>
                    <span class="cr-stub-year">@booking.StartLocal.ToString("yyyy")</span>
                </div>
                <div class="cr-stub-main">
                    <h2 class="cr-stub-title">
                        <a asp-controller="Booking" asp-action="Confirmation" asp-route-code="@booking.BookingCode">@booking.MovieTitle</a>
                    </h2>
                    <p class="cr-stub-line">@booking.TheaterName, @booking.RoomName</p>
                    <p class="cr-stub-line">Ghế @string.Join(", ", booking.Seats.Select(s => s.Label))</p>
                </div>
                <div class="cr-stub-side">
                    <span class="cr-stub-code">@booking.BookingCode</span>
                    <span class="cr-stub-total">@booking.TotalAmount.Vnd()</span>
                    <span class="cr-stub-status @(booking.Status == BookingStatus.Confirmed ? "is-ok" : null)">@booking.StatusLabel · @booking.PaymentStateLabel</span>
                </div>
            </article>
        }
    </div>

    @if (Model.Page is { } page)
    {
        <partial name="~/Areas/Admin/Views/Shared/_Pager.cshtml"
                 model="@(new PagerModel("MyBookings", page, new Dictionary<string, object?> { ["tab"] = Model.Tab }))" />
    }
}
