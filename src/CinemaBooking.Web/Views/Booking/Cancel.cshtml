@model CancelBookingPageViewModel
@{
    ViewData["Title"] = $"Hủy vé {Model.Booking.BookingCode}";
}

<section class="page-head">
    <h1 class="page-title">Hủy vé @Model.Booking.BookingCode</h1>
    <p class="cb-muted page-subtitle">
        Vé đã hủy sẽ trả ghế về sơ đồ và không thể khôi phục. Vui lòng kiểm tra kỹ trước khi xác nhận.
    </p>
</section>

@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger" role="alert">@error</div>
}

<div class="cb-card booking-confirmation">
    <partial name="_BookingDetails" model="Model.Booking" />

    @if (Model.CanCancel)
    {
        <div class="alert alert-warning" role="status">
            @if (Model.RefundAmount > 0)
            {
                <strong>Hoàn tiền dự kiến: @Model.RefundAmount.ToString("N0") ₫</strong>
                <span> — về đúng phương thức thanh toán ban đầu (VNPAY).</span>
            }
            else
            {
                <span>Đơn chưa thanh toán nên không phát sinh hoàn tiền.</span>
            }
        </div>

        <form asp-controller="Booking" asp-action="Cancel" method="post" class="cancel-form">
            <input type="hidden" name="code" value="@Model.Booking.BookingCode" />

            @if (Model.RequiresEmail)
            {
                <div class="mb-3">
                    <label for="email" class="form-label">Email đã dùng khi đặt vé</label>
                    <input id="email" name="email" type="email" class="form-control"
                           autocomplete="email" required placeholder="ban@example.com" />
                    <div class="form-text">Cần khớp email trên vé để bảo vệ đơn của bạn.</div>
                </div>
            }

            <div class="booking-actions">
                <button type="submit" class="btn btn-danger">Xác nhận hủy vé</button>
                <a asp-controller="Booking" asp-action="Confirmation" asp-route-code="@Model.Booking.BookingCode"
                   class="btn btn-outline-secondary">Giữ vé</a>
            </div>
        </form>
    }
    else
    {
        <div class="alert alert-secondary" role="status">
            @(Model.Reason ?? "Vé này hiện không thể hủy.")
        </div>
        <div class="booking-actions">
            <a asp-controller="Booking" asp-action="Confirmation" asp-route-code="@Model.Booking.BookingCode"
               class="btn btn-primary">Quay lại vé</a>
        </div>
    }
</div>
