@model SeatMapViewModel
@{
    ViewData["Title"] = $"Chọn ghế — {Model.MovieTitle}";
    var seatColumns = Model.TotalColumns;

    // Admin/BranchAdmin chỉ xem: không có thanh tổng tiền, nút thanh toán hay thao tác chọn ghế.
    var staffPreview = ViewData["StaffPreview"] as bool? == true;
    var cells = Model.Rows.SelectMany(r => r.Seats).OfType<SeatCellViewModel>().Where(c => !c.IsCoveredByPair).ToList();
    var hasVip = cells.Any(c => c.Type == SeatType.Vip);
    var hasCouple = cells.Any(c => c.Type == SeatType.Couple);
    var promotions = cells.Where(c => c.HasPromotion).Select(c => c.PromotionTitle!).Distinct().ToList();

    string TypeClass(SeatType type) => type switch
    {
        SeatType.Vip => "vip seat-vip",
        SeatType.Couple => "couple seat-couple",
        _ => "seat-standard",
    };
}

<div class="seatmap-page">
    <header class="cr-card seatmap-header">
        <small>@Model.TheaterName · @Model.City · @Model.RoomName@(Model.FormatLabel is null ? "" : " (" + Model.FormatLabel + ")")</small>
        <h1 class="cb-page-title seatmap-title">@Model.MovieTitle</h1>
        <p class="seatmap-when">Suất @Model.StartLocal.ToString("HH:mm · dd/MM/yyyy")</p>
    </header>

    @if (staffPreview)
    {
        <div class="cb-alert cb-alert-info" role="status">
            <span>
                <strong>Chế độ xem sơ đồ ghế.</strong> Tài khoản quản trị không đặt vé — đăng nhập bằng tài khoản khách để mua vé.
                Ghế vừa được đặt hoặc đang thanh toán cập nhật trực tiếp trên sơ đồ.
                <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index">Về trang quản trị</a>
            </span>
        </div>
    }
    else
    {
        <partial name="_BookingSteps" model="1" />
    }

    @if (promotions.Count > 0)
    {
        <div class="cb-alert cb-alert-success" role="status">
            <span>Suất này đang có khuyến mãi <strong>@string.Join(", ", promotions)</strong>. Giá giảm đã được trừ vào từng ghế.</span>
        </div>
    }

    @if (TempData["Error"] is string error)
    {
        <div class="cb-alert cb-alert-danger" role="alert">
            <span aria-hidden="true">✕</span>
            <span>@error</span>
        </div>
    }

    <div class="seat-map-shell" id="seat-map"
         data-showtime-id="@Model.ShowtimeId"
         data-readonly="@(staffPreview ? "true" : "false")"
         aria-describedby="seat-map-legend">

        <div class="seat-map-screen-wrap" aria-hidden="true">
            <div class="seat-map-beam"></div>
            <div class="seat-map-screen">
                <span>MÀN HÌNH CHIẾU</span>
            </div>
        </div>

        <div class="seat-map-viewport">
            <div class="seat-rows" style="--seat-cols: @seatColumns">
                <div class="seat-row seat-row-head" aria-hidden="true">
                    <span class="seat-map-row-label"></span>
                    @for (var col = 1; col <= seatColumns; col++)
                    {
                        <span class="seat-col-label">@col</span>
                    }
                    <span class="seat-map-row-label"></span>
                </div>

                @foreach (var row in Model.Rows)
                {
                    <div class="seat-row">
                        <span class="seat-map-row-label" aria-hidden="true">@row.Label</span>
                        @foreach (var seat in row.Seats)
                        {
                            if (seat is null)
                            {
                                <span class="seat seat-gap" aria-hidden="true"></span>
                                continue;
                            }

                            // Nửa phải của ghế đôi đã được vẽ chung trong khối của nửa trái.
                            if (seat.IsCoveredByPair) { continue; }

                            // Ghế đôi lẻ loi: không có cặp thì không bán, nhưng vẫn hiện để khách thấy sơ đồ đầy đủ.
                            if (seat.IsOrphan)
                            {
                                <span class="seat couple seat-couple seat-orphan"
                                      title="Ghế đôi @seat.Label không có cặp — không bán"
                                      aria-label="Ghế đôi @seat.Label không có cặp, không bán được">@seat.Label</span>
                                continue;
                            }

                            var seatKind = seat.IsPair ? "Ghế đôi" : "Ghế";
                            <button type="button"
                                    class="seat @TypeClass(seat.Type) @(seat.IsPair ? "couple seat-couple seat-pair" : null) @(seat.IsBooked ? "is-booked" : "is-free")"
                                    data-seat-ids="@string.Join(",", seat.SeatIds)"
                                    data-seat-label="@seat.Label"
                                    data-seat-price="@seat.Price.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)"
                                    data-seat-type="@seat.Type"
                                    aria-pressed="@(seat.IsBooked ? "true" : "false")"
                                    aria-label="@seatKind @seat.Label, @seat.Type.Label(), @seat.Price.Vnd()@(seat.HasPromotion ? $", đang giảm giá ({seat.PromotionTitle}), giá gốc {seat.ListPrice.Vnd()}" : "")@(seat.IsBooked ? ", đã được đặt" : "")"
                                    title="@seatKind @seat.Label · @seat.Type.Label() · @seat.Price.Vnd()@(seat.HasPromotion ? $" (gốc {seat.ListPrice.Vnd()} — {seat.PromotionTitle})" : "")"
                                    disabled="@(seat.IsBooked || staffPreview)">
                                <span class="seat-label">@seat.Label</span>
                            </button>
                        }
                        <span class="seat-map-row-label" aria-hidden="true">@row.Label</span>
                    </div>
                }
            </div>
        </div>

        <p class="seat-map-hint" aria-hidden="true">↔ Kéo ngang để xem toàn bộ sơ đồ khán phòng.</p>

        <ul class="seat-map-legend" id="seat-map-legend" aria-label="Chú thích trạng thái và loại ghế">
            <li><span class="seat-swatch is-free" aria-hidden="true"></span>Trống</li>
            <li><span class="seat-swatch is-mine" aria-hidden="true"></span>Bạn đã chọn</li>
            <li><span class="seat-swatch is-booked" aria-hidden="true">✕</span>Đã đặt / đang thanh toán</li>
            @if (hasVip)
            {
                <li><span class="seat-swatch is-vip" aria-hidden="true">★</span>Ghế VIP</li>
            }
            @if (hasCouple)
            {
                <li><span class="seat-swatch is-couple" aria-hidden="true">♥</span>Ghế đôi</li>
            }
        </ul>
    </div>
</div>

@if (!staffPreview)
{
<div class="seat-summary-dock" id="seat-summary" aria-live="polite">
    <div class="seat-summary-dock-inner">
        <div class="seat-summary-left">
            <div id="seat-selected-list" class="seat-selected-list cb-muted">Chưa chọn ghế nào</div>
            <div id="seat-hold-timer" class="cb-hold-timer" role="timer" hidden></div>
            <span id="seat-hold-note" class="cb-muted">Ghế chỉ được giữ từ lúc bạn bấm Thanh toán.</span>
        </div>

        <div class="seat-summary-right">
            <div class="seat-total-block">
                <span class="seat-total-label">Tổng tiền</span>
                <strong class="seat-total-val" id="seat-total">0 ₫</strong>
            </div>

            <form asp-action="SelectSeats" method="post" id="seat-selection-form">
                <input type="hidden" name="showtimeId" value="@Model.ShowtimeId" />
                <div id="seat-selected-inputs"></div>
                <button type="submit" class="cb-btn cb-btn-primary cb-btn-lg seat-continue-btn" id="seat-continue" disabled>
                    Tiếp tục thanh toán
                </button>
            </form>
        </div>
    </div>
</div>
}

<div id="seat-toasts" class="seat-toasts" aria-live="polite" aria-atomic="true"></div>

@section Scripts {
    <script src="~/lib/signalr/signalr.min.js"></script>
    <script src="~/js/seat-map.js" asp-append-version="true"></script>
}
