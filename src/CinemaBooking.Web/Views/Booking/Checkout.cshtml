@model CheckoutPageViewModel
@{
    ViewData["Title"] = "Thanh toán";
}

<section class="page-head">
    <h1 class="page-title">Thanh toán</h1>
    <p class="cb-muted page-subtitle">Kiểm tra lại ghế và điền thông tin liên hệ để nhận vé qua email.</p>
</section>

<partial name="_BookingSteps" model="2" />

@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger" role="alert">@error</div>
}

<div class="row g-4">
    <div class="col-lg-7">
        <div class="cb-card checkout-card">
            <h2 class="checkout-heading">Thông tin khách</h2>
            <partial name="_CheckoutForm" model="Model.Form" />
        </div>
    </div>

    <div class="col-lg-5">
        <aside class="cb-card checkout-summary" aria-label="Tóm tắt đơn hàng">
            <h2 class="checkout-heading">@Model.Summary.MovieTitle</h2>
            <p class="cb-muted mb-1">@Model.Summary.TheaterName (@Model.Summary.City) · @Model.Summary.RoomName@(Model.Summary.FormatLabel is null ? "" : " (" + Model.Summary.FormatLabel + ")")</p>
            <p class="cb-muted">@Model.Summary.StartLocal.ToString("HH:mm dd/MM/yyyy")</p>

            <div id="checkout-hold-timer" class="seat-timer checkout-hold-timer"
                 role="timer" aria-live="polite"
                 data-remaining-seconds="@Model.HoldSecondsRemaining"
                 data-seat-map-url="@Url.Action("SeatMap", "Booking", new { id = Model.Summary.ShowtimeId })">
                Đang tính thời gian giữ ghế…
            </div>
            <div id="checkout-expired" class="alert alert-warning mt-2" hidden>
                Đã hết thời gian giữ ghế. Đang đưa bạn về sơ đồ ghế để chọn lại…
            </div>

            <div class="table-responsive">
                <table class="table table-sm checkout-table">
                    <thead>
                        <tr><th>Ghế</th><th>Loại</th><th class="text-end">Giá</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var seat in Model.Summary.Seats)
                        {
                            <tr>
                                <td>@seat.Label</td>
                                <td>@seat.Type.Label()</td>
                                <td class="text-end">
                                    @if (seat.HasPromotion)
                                    {
                                        <span class="text-decoration-line-through cb-muted small">@seat.ListPrice.Vnd()</span>
                                        <br />
                                        <span class="small text-success">@seat.PromotionTitle</span>
                                        <br />
                                    }
                                    @seat.Price.Vnd()
                                </td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        @if (Model.Summary.HasVoucher)
                        {
                            <tr>
                                <td colspan="2">Tạm tính</td>
                                <td class="text-end">@Model.Summary.Subtotal.Vnd()</td>
                            </tr>
                            <tr>
                                <td colspan="2" class="text-success">Mã giảm giá @Model.Summary.VoucherCode</td>
                                <td class="text-end text-success">−@Model.Summary.VoucherDiscount.Vnd()</td>
                            </tr>
                        }
                        <tr>
                            <th colspan="2">Tổng cộng</th>
                            <th class="text-end">@Model.Summary.TotalAmount.Vnd()</th>
                        </tr>
                    </tfoot>
                </table>
            </div>

            @* Mã giảm giá: lưu vào phiên, server kiểm tra lại lúc dựng trang và lúc chốt đơn. *@
            <section class="voucher-box" aria-label="Mã giảm giá">
                @if (Model.Summary.HasVoucher)
                {
                    <div class="voucher-applied" role="status">
                        <div>
                            <strong>@Model.Summary.VoucherCode</strong>
                            <span class="small cb-muted d-block">@Model.Summary.VoucherTitle · giảm @Model.Summary.VoucherDiscount.Vnd()</span>
                        </div>
                        <form asp-action="RemoveVoucher" method="post">
                            <button type="submit" class="btn btn-sm btn-outline-secondary">Bỏ mã</button>
                        </form>
                    </div>
                }
                else
                {
                    <form asp-action="ApplyVoucher" method="post" class="voucher-form">
                        <label for="voucher-code" class="visually-hidden">Mã giảm giá</label>
                        <input id="voucher-code" name="code" class="form-control text-uppercase" maxlength="30" autocomplete="off"
                               placeholder="Nhập mã giảm giá" />
                        <button type="submit" class="btn btn-outline-primary">Áp dụng</button>
                    </form>
                }
                @if (TempData["VoucherError"] is string voucherError)
                {
                    <p class="small text-danger mb-0 mt-2" role="alert">@voucherError</p>
                }
            </section>

            <a asp-controller="Booking" asp-action="SeatMap" asp-route-id="@Model.Summary.ShowtimeId"
               class="btn btn-outline-secondary w-100 mt-2">Chọn lại ghế</a>
        </aside>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/checkout-timer.js" asp-append-version="true"></script>
}
