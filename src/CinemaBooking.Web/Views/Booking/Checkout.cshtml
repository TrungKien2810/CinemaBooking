@model CheckoutPageViewModel
@{
    ViewData["Title"] = "Thanh toán";
}

@section Styles {
    <link rel="stylesheet" href="~/css/booking.css" asp-append-version="true" />
}

<div class="cb-page-header">
    <h1 class="cb-page-title">Thanh toán</h1>
    <p class="cb-page-subtitle">Kiểm tra lại ghế và điền thông tin liên hệ để nhận vé qua email.</p>
</div>

<partial name="_BookingSteps" model="2" />

@if (TempData["Error"] is string error)
{
    <div class="cb-alert cb-alert-danger" role="alert">
        <span aria-hidden="true">✕</span>
        <span>@error</span>
    </div>
}

<div class="cb-checkout-grid">
    <div class="cb-checkout-form-card">
        <h2 class="cb-section-title">
            Thông tin khách hàng
        </h2>
        <partial name="_CheckoutForm" model="Model.Form" />
    </div>

    <aside class="cb-ticket" aria-label="Tóm tắt đơn hàng">
        <div class="cb-ticket-head">
            <div class="cb-ticket-brand">
                CINEMABOOKING
            </div>
            <span class="cb-badge cb-badge-accent">Tóm tắt đơn</span>
        </div>

        <div class="cb-ticket-body">
            <h2 class="cb-ticket-movie-title">@Model.Summary.MovieTitle</h2>
            <div class="cb-ticket-theater">
                <span>@Model.Summary.TheaterName (@Model.Summary.City) · @Model.Summary.RoomName@(Model.Summary.FormatLabel is null ? "" : " (" + Model.Summary.FormatLabel + ")")</span>
                <span class="cb-muted">@Model.Summary.StartLocal.ToString("HH:mm · dd/MM/yyyy")</span>
            </div>

            <div class="cb-hold-timer-box">
                <div id="checkout-hold-timer" class="cb-hold-timer seat-timer"
                     role="timer" aria-live="polite"
                     data-remaining-seconds="@Model.HoldSecondsRemaining"
                     data-seat-map-url="@Url.Action("SeatMap", "Booking", new { id = Model.Summary.ShowtimeId })">
                    Đang tính thời gian giữ ghế…
                </div>
                <div id="checkout-expired" class="cb-alert cb-alert-warning" style="margin: 0;" hidden>
                    Đã hết thời gian giữ ghế. Đang đưa bạn về sơ đồ ghế để chọn lại…
                </div>
            </div>

            <div class="cb-ticket-perforation"></div>

            <table class="cb-ticket-table">
                <thead>
                    <tr>
                        <th>Ghế</th>
                        <th>Loại</th>
                        <th class="cb-num">Giá</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var seat in Model.Summary.Seats)
                    {
                        <tr>
                            <td><strong>@seat.Label</strong></td>
                            <td><span class="cb-badge cb-badge-surface">@seat.Type.Label()</span></td>
                            <td class="cb-num">
                                @if (seat.HasPromotion)
                                {
                                    <s class="cb-muted">@seat.ListPrice.Vnd()</s>
                                    <br />
                                    <small class="cb-success-text">@seat.PromotionTitle</small>
                                    <br />
                                }
                                @seat.Price.Vnd()
                            </td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    @if (Model.Summary.HasVoucher)
                    {
                        <tr>
                            <th colspan="2">Tạm tính</th>
                            <td class="cb-num">@Model.Summary.Subtotal.Vnd()</td>
                        </tr>
                        <tr>
                            <th colspan="2" class="cb-success-text">Mã giảm giá @Model.Summary.VoucherCode</th>
                            <td class="cb-num cb-success-text">−@Model.Summary.VoucherDiscount.Vnd()</td>
                        </tr>
                    }
                    <tr>
                        <th colspan="2">Tổng cộng</th>
                        <td class="cb-num cb-ticket-total-val" data-total>@Model.Summary.TotalAmount.Vnd()</td>
                    </tr>
                </tfoot>
            </table>

            @* Mã giảm giá: lưu vào phiên, server kiểm tra lại lúc dựng trang và lúc chốt đơn. *@
            <section class="cb-voucher" aria-label="Mã giảm giá">
                @if (Model.Summary.HasVoucher)
                {
                    <div class="cb-voucher-applied" role="status">
                        <div>
                            <strong>@Model.Summary.VoucherCode</strong>
                            <small class="cb-muted">@Model.Summary.VoucherTitle · giảm @Model.Summary.VoucherDiscount.Vnd()</small>
                        </div>
                        <form asp-action="RemoveVoucher" method="post">
                            <button type="submit" class="cb-btn cb-btn-outline cb-btn-sm">Bỏ mã</button>
                        </form>
                    </div>
                }
                else
                {
                    <form asp-action="ApplyVoucher" method="post" class="cb-voucher-form" data-submit-loading>
                        <label for="voucher-code" class="visually-hidden">Mã giảm giá</label>
                        <input id="voucher-code" name="code" class="cb-input" maxlength="30" autocomplete="off"
                               style="text-transform: uppercase" placeholder="Nhập mã giảm giá" />
                        <button type="submit" class="cb-btn cb-btn-outline">Áp dụng</button>
                    </form>
                }
                @if (TempData["VoucherError"] is string voucherError)
                {
                    <p class="cb-field-error" role="alert">@voucherError</p>
                }
            </section>

            <a asp-controller="Booking" asp-action="SeatMap" asp-route-id="@Model.Summary.ShowtimeId"
               class="cb-btn cb-btn-outline" style="width: 100%; margin-top: 0.5rem;">
                <span aria-hidden="true">←</span> Chọn lại ghế
            </a>
        </div>
    </aside>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/checkout-timer.js" asp-append-version="true"></script>
}
