@model CheckoutFormModel

<form asp-controller="Booking" asp-action="Checkout" method="post" class="cb-form">
    <div asp-validation-summary="ModelOnly" class="cb-alert cb-alert-danger" role="alert"></div>

    <div class="cb-form-group">
        <label asp-for="CustomerName" class="cb-label"></label>
        <input asp-for="CustomerName" class="cb-input" autocomplete="name" placeholder="Nguyễn Văn A" />
        <span asp-validation-for="CustomerName" class="cb-form-error"></span>
    </div>

    <div class="cb-form-group">
        <label asp-for="CustomerEmail" class="cb-label"></label>
        <input asp-for="CustomerEmail" class="cb-input" autocomplete="email" placeholder="ban@example.com" />
        <span asp-validation-for="CustomerEmail" class="cb-form-error"></span>
    </div>

    <div class="cb-form-group">
        <label asp-for="CustomerPhone" class="cb-label"></label>
        <input asp-for="CustomerPhone" class="cb-input" autocomplete="tel" placeholder="09xx xxx xxx" />
        <span asp-validation-for="CustomerPhone" class="cb-form-error"></span>
    </div>

    <div class="cb-payment-section">
        <div class="cb-label" style="margin-bottom: 0.5rem;">Phương thức thanh toán</div>
        <div class="cb-payment-option is-selected">
            <input type="radio" checked class="cb-radio" id="payment-vnpay" name="PaymentMethod" value="VNPAY" aria-label="Cổng thanh toán VNPAY" />
            <div>
                <div class="cb-payment-title">
                    <span>VNPAY</span>
                    <span class="cb-payment-badge">SANDBOX</span>
                </div>
                <div class="cb-payment-desc">
                    Thanh toán an toàn qua cổng VNPAY (sandbox.vnpayment.vn) bằng thẻ ATM nội địa, QR Code hoặc thẻ quốc tế.
                </div>
            </div>
        </div>
    </div>

    <p class="cb-secure-note">
        <span>Thông tin liên hệ chỉ dùng để gửi vé điện tử và đối chiếu tại quầy rạp.</span>
    </p>

    <button type="submit" id="checkout-submit" class="cb-btn cb-btn-primary cb-btn-lg" style="width: 100%;">
        Xác nhận và thanh toán
    </button>
</form>
