@model BookingLookupViewModel
@{
    ViewData["Title"] = "Tra cứu vé";
}

@section Styles {
    <link rel="stylesheet" href="~/css/booking.css" asp-append-version="true" />
}

<section class="cr-card">
    <small>Đã đặt vé?</small>
    <h1 class="cb-page-title">Tra cứu vé</h1>
</section>

<form asp-controller="Booking" asp-action="Lookup" method="get" class="cr-lookup" role="search">
    <label for="code" class="cr-lookup-label">Mã vé</label>
    <div class="cr-lookup-row">
        <input id="code" name="code" value="@Model.Code" class="cr-lookup-input"
               placeholder="CB-8F3A21" autocomplete="off" />
        <button type="submit" class="cb-btn cb-btn-primary">Tra cứu</button>
    </div>
</form>

@if (!string.IsNullOrWhiteSpace(Model.Error))
{
    <p class="cr-lookup-error" role="alert">@Model.Error</p>
}

@if (Model.Booking is not null)
{
    <div class="cb-ticket cb-lookup-result">
        <div class="cb-ticket-body">
            <partial name="_BookingDetails" model="Model.Booking" />

            <div class="cb-booking-actions">
                <a asp-controller="Booking" asp-action="Confirmation" asp-route-code="@Model.Booking.BookingCode"
                   class="cb-btn cb-btn-primary">Mở trang xác nhận vé</a>
                <a asp-controller="Home" asp-action="Index" class="cb-btn cb-btn-outline">Về trang chủ</a>
            </div>
        </div>
    </div>
}
else if (string.IsNullOrWhiteSpace(Model.Code))
{
    <p class="cr-lookup-help">
        Mã vé nằm trong email xác nhận, hoặc hiện ngay sau khi bạn đặt vé thành công.
        Chưa đặt? <a asp-controller="Home" asp-action="Index">Xem phim đang chiếu</a>.
    </p>
}
