@model string?
@{
    ViewData["Title"] = "Không tìm thấy vé";
}

@section Styles {
    <link rel="stylesheet" href="~/css/booking.css" asp-append-version="true" />
}

<div class="cb-error-container">
    <div class="cb-empty">
        <h1 class="cb-empty-title">Không tìm thấy vé</h1>
        <p class="cb-empty-desc">
            @if (string.IsNullOrWhiteSpace(Model))
            {
                @:Mã vé không hợp lệ hoặc chưa được nhập.
            }
            else
            {
                <text>Không có vé nào khớp với mã <strong>@Model</strong>. Vui lòng kiểm tra lại email xác nhận.</text>
            }
        </p>
        <div style="display: flex; gap: 0.75rem; flex-wrap: wrap; justify-content: center; margin-top: 1rem;">
            <a asp-controller="Booking" asp-action="Lookup" class="cb-btn cb-btn-primary">
                Tra cứu lại
            </a>
            <a asp-controller="Home" asp-action="Index" class="cb-btn cb-btn-outline">
                Về trang chủ
            </a>
        </div>
    </div>
</div>
