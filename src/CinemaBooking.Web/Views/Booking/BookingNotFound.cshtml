@model string?
@{
    ViewData["Title"] = "Không tìm thấy vé";
}

<div class="error-shell">
    <div class="cb-card error-card">
        <div class="error-icon" aria-hidden="true">🎟️</div>
        <h1>Không tìm thấy vé</h1>
        <p class="cb-muted">
            @if (string.IsNullOrWhiteSpace(Model))
            {
                @:Mã vé không hợp lệ hoặc chưa được nhập.
            }
            else
            {
                <text>Không có vé nào khớp với mã <strong>@Model</strong>. Vui lòng kiểm tra lại email xác nhận.</text>
            }
        </p>
        <div class="d-flex gap-2 justify-content-center flex-wrap mt-3">
            <a asp-controller="Booking" asp-action="Lookup" class="btn btn-primary">Tra cứu lại</a>
            <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">Về trang chủ</a>
        </div>
    </div>
</div>
