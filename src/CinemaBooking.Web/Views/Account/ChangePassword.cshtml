@model ChangePasswordViewModel
@{
    ViewData["Title"] = "Đổi mật khẩu";
}

<section class="page-head">
    <h1 class="page-title">Đổi mật khẩu</h1>
    <p class="cb-muted page-subtitle">Sau khi đổi, các phiên đăng nhập khác sẽ bị đăng xuất.</p>
</section>

@if (TempData["Success"] is string success)
{
    <div class="alert alert-success" role="alert">@success</div>
}

<div class="cb-card account-card">
    <form asp-action="ChangePassword" method="post">
        <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

        <div class="mb-3">
            <label asp-for="CurrentPassword" class="form-label">Mật khẩu hiện tại</label>
            <div class="pwd-field">
                <input asp-for="CurrentPassword" class="form-control" autocomplete="current-password" />
                <button type="button" class="pwd-toggle" data-password-toggle="CurrentPassword"
                        aria-label="Hiện mật khẩu">👁️</button>
            </div>
            <span asp-validation-for="CurrentPassword" class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label asp-for="NewPassword" class="form-label">Mật khẩu mới</label>
            <div class="pwd-field">
                <input asp-for="NewPassword" class="form-control" autocomplete="new-password" />
                <button type="button" class="pwd-toggle" data-password-toggle="NewPassword"
                        aria-label="Hiện mật khẩu">👁️</button>
            </div>
            <span asp-validation-for="NewPassword" class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label asp-for="ConfirmPassword" class="form-label">Nhập lại mật khẩu mới</label>
            <div class="pwd-field">
                <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                <button type="button" class="pwd-toggle" data-password-toggle="ConfirmPassword"
                        aria-label="Hiện mật khẩu">👁️</button>
            </div>
            <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
        </div>

        <div class="d-flex gap-2 flex-wrap">
            <button type="submit" class="btn btn-primary">Đổi mật khẩu</button>
            <a asp-action="Profile" class="btn btn-outline-secondary">Quay lại tài khoản</a>
        </div>
    </form>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
    <script src="~/js/auth-ui.js" asp-append-version="true"></script>
}
