@model ChangePasswordViewModel
@{
    ViewData["Title"] = "Đổi mật khẩu";
}

@section Styles {
    <link rel="stylesheet" href="~/css/account.css" asp-append-version="true" />
}

<div class="security-layout">
    <!-- Cột trái: Form phẳng đổi mật khẩu -->
    <main class="security-form-card">
        <div class="login-form-head">
            <h1 class="login-form-title">Đổi mật khẩu</h1>
            <p class="login-form-sub">Sau khi cập nhật thành công, phiên đăng nhập sẽ được làm mới để bảo vệ an toàn cho tài khoản.</p>
        </div>

        @if (TempData["Success"] is string success)
        {
            <div class="auth-alert auth-alert-success" role="status">
                <span class="auth-alert-icon" aria-hidden="true">✓</span>
                <div>@success</div>
            </div>
        }

        <form asp-action="ChangePassword" method="post" class="auth-form">
            <div asp-validation-summary="ModelOnly" class="auth-validation-summary"></div>

            <div class="auth-field">
                <label asp-for="CurrentPassword" class="auth-label">Mật khẩu hiện tại</label>
                <div class="auth-input-wrap">
                    <input asp-for="CurrentPassword" class="auth-input auth-input-has-toggle" autocomplete="current-password"
                           placeholder="Nhập mật khẩu đang dùng" />
                    <button type="button" class="auth-toggle-pwd" data-password-toggle="CurrentPassword"
                            aria-label="Hiện mật khẩu">Hiện</button>
                </div>
                <span asp-validation-for="CurrentPassword" class="auth-field-error"></span>
            </div>

            <div class="auth-field">
                <label asp-for="NewPassword" class="auth-label">Mật khẩu mới</label>
                <div class="auth-input-wrap">
                    <input asp-for="NewPassword" class="auth-input auth-input-has-toggle" autocomplete="new-password"
                           placeholder="Tối thiểu 8 ký tự" data-password-input />
                    <button type="button" class="auth-toggle-pwd" data-password-toggle="NewPassword"
                            aria-label="Hiện mật khẩu">Hiện</button>
                </div>
                <div class="auth-pwd-strength" data-password-strength hidden>
                    <div class="auth-pwd-track">
                        <div class="auth-pwd-bar" data-password-bar></div>
                    </div>
                    <span class="auth-pwd-label" data-password-label></span>
                </div>
                <span asp-validation-for="NewPassword" class="auth-field-error"></span>
            </div>

            <div class="auth-field">
                <label asp-for="ConfirmPassword" class="auth-label">Nhập lại mật khẩu mới</label>
                <div class="auth-input-wrap">
                    <input asp-for="ConfirmPassword" class="auth-input auth-input-has-toggle" autocomplete="new-password"
                           placeholder="Nhập lại mật khẩu mới vừa đặt" />
                    <button type="button" class="auth-toggle-pwd" data-password-toggle="ConfirmPassword"
                            aria-label="Hiện mật khẩu">Hiện</button>
                </div>
                <span asp-validation-for="ConfirmPassword" class="auth-field-error"></span>
            </div>

            <div class="profile-actions-bar">
                <button type="submit" class="cb-btn cb-btn-primary">Cập nhật mật khẩu</button>
                <a asp-action="Profile" class="cb-btn cb-btn-secondary">Quay lại hồ sơ</a>
            </div>
        </form>
    </main>

    <!-- Cột phải: Bảng quy chuẩn an ninh -->
    <aside class="security-guide-card">
        <div class="security-guide-head">
            <span>Quy chuẩn an ninh</span>
        </div>

        <div class="security-guide-list">
            <div class="security-guide-item">
                <span class="security-guide-icon" aria-hidden="true">✦</span>
                <div>
                    <strong>Tối thiểu 8 ký tự:</strong> Kết hợp giữa chữ hoa, chữ thường và chữ số để đạt độ bảo vệ tối đa.
                </div>
            </div>

            <div class="security-guide-item">
                <span class="security-guide-icon" aria-hidden="true">✦</span>
                <div>
                    <strong>Không dùng mật khẩu cũ:</strong> Tránh đặt mật khẩu trùng với tài khoản ngân hàng hoặc mạng xã hội.
                </div>
            </div>

            <div class="security-guide-item">
                <span class="security-guide-icon" aria-hidden="true">✦</span>
                <div>
                    <strong>Tự động làm mới phiên:</strong> Hệ thống sẽ cấp lại security token mới và giữ cho phiên làm việc hiện tại an toàn.
                </div>
            </div>
        </div>
    </aside>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
    <script src="~/js/auth-ui.js" asp-append-version="true"></script>
}
