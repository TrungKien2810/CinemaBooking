@model ForgotPasswordViewModel
@{
    ViewData["Title"] = "Quên mật khẩu";
    var sent = ViewData["Sent"] is true;
}

@section Styles {
    <link rel="stylesheet" href="~/css/account.css" asp-append-version="true" />
}

<div class="forgot-shell">
    <div class="forgot-card">
        <div class="forgot-head">
            <div class="forgot-icon-wrap" aria-hidden="true">
                </div>
            <h1 class="forgot-title">Khôi phục mật khẩu</h1>
            <p class="forgot-sub">
                Nhập địa chỉ email đã đăng ký. Hệ thống sẽ gửi cho bạn một liên kết an toàn để đặt mật khẩu mới.
            </p>
        </div>

        @if (sent)
        {
            <div class="forgot-sent-card" role="status">
                <p class="forgot-sent-desc">
                    Nếu địa chỉ <strong>@Model.Email</strong> tồn tại trong hệ thống, hướng dẫn đặt lại mật khẩu đã được gửi đến hòm thư của bạn.<br /><br />
                    Vui lòng kiểm tra hộp thư đến (bao gồm cả thư mục Spam hoặc Quảng cáo) và làm theo hướng dẫn trong liên kết.
                </p>
                <a asp-action="Login" class="cb-btn cb-btn-primary" style="width: 100%;">Quay về đăng nhập</a>
            </div>
        }
        else
        {
            <form asp-action="ForgotPassword" method="post" class="auth-form">
                <div asp-validation-summary="ModelOnly" class="auth-validation-summary"></div>

                <div class="auth-field">
                    <label asp-for="Email" class="auth-label">Email tài khoản</label>
                    <div class="auth-input-wrap">
                        <input asp-for="Email" class="auth-input" autocomplete="email" placeholder="ban@example.com" />
                    </div>
                    <span asp-validation-for="Email" class="auth-field-error"></span>
                    <span class="auth-field-hint">Liên kết khôi phục sẽ có hiệu lực trong vòng 24 giờ kể từ khi gửi.</span>
                </div>

                <button type="submit" class="cb-btn cb-btn-primary auth-submit-btn">Gửi liên kết khôi phục</button>
            </form>

            <p class="auth-switch-prompt">
                <a asp-action="Login">Quay lại đăng nhập</a>
            </p>
        }
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
