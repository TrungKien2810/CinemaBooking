@model ForgotPasswordViewModel
@{
    ViewData["Title"] = "Quên mật khẩu";
    var sent = ViewData["Sent"] is true;
}

<div class="auth-shell">
    <div class="cb-card auth-card">
        <div class="auth-brand">
            <span class="brand-mark" aria-hidden="true">🎬</span>
            <span>CinemaBooking<span class="brand-accent">.Smart</span></span>
        </div>

        <h1 class="auth-title">Quên mật khẩu</h1>
        <p class="cb-muted auth-subtitle">
            Nhập email đã đăng ký, chúng tôi sẽ gửi liên kết đặt lại mật khẩu.
        </p>

        @if (sent)
        {
            <div class="alert alert-success" role="status">
                Nếu email tồn tại trong hệ thống, liên kết đặt lại mật khẩu đã được gửi.
                Vui lòng kiểm tra hộp thư (cả mục Spam).
            </div>
            <a asp-action="Login" class="btn btn-primary w-100">Về trang đăng nhập</a>
        }
        else
        {
            <form asp-action="ForgotPassword" method="post">
                <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

                <div class="mb-3">
                    <label asp-for="Email" class="form-label">Email</label>
                    <input asp-for="Email" class="form-control" autocomplete="email" placeholder="ban@example.com" />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <button type="submit" class="btn btn-primary w-100">Gửi liên kết</button>
            </form>

            <p class="auth-switch mt-3">
                <a asp-action="Login">Quay lại đăng nhập</a>
            </p>
        }
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
