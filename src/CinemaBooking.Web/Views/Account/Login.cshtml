@model LoginViewModel
@{
    ViewData["Title"] = "Đăng nhập";
}

@section Styles {
    <link rel="stylesheet" href="~/css/account.css" asp-append-version="true" />
}

<div class="login-split">
    <div class="cr-auth-posters" aria-hidden="true">
        <img src="~/img/posters/dia-dao.jpg" alt="" /><img src="~/img/posters/inside-out-2.jpg" alt="" />
        <img src="~/img/posters/dune-part-two.jpg" alt="" /><img src="~/img/posters/nha-ba-nu.jpg" alt="" />
        <img src="~/img/posters/mat-biec.jpg" alt="" /><img src="~/img/posters/dia-dao.jpg" alt="" />
        <p class="cr-auth-tag">Đăng nhập để giữ ghế và xem lại vé của bạn.</p>
    </div>

    <!-- Cột phải: Form phẳng đăng nhập -->
    <div class="login-form-col">
        <div class="login-form-head">
            <h2 class="login-form-title">Đăng nhập</h2>
            <p class="login-form-sub">Nhập thông tin tài khoản của bạn để vào rạp.</p>
        </div>

        @if (TempData["Success"] is string success)
        {
            <div class="auth-alert auth-alert-success" role="status">
                
                <div>@success</div>
            </div>
        }

        <form asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post" class="auth-form">
            <div asp-validation-summary="ModelOnly" class="auth-validation-summary"></div>

            <div class="auth-field">
                <label asp-for="Email" class="auth-label">Email</label>
                <div class="auth-input-wrap">
                    <input asp-for="Email" class="auth-input" autocomplete="username" placeholder="ban@example.com" />
                </div>
                <span asp-validation-for="Email" class="auth-field-error"></span>
            </div>

            <div class="auth-field">
                <label asp-for="Password" class="auth-label">Mật khẩu</label>
                <div class="auth-input-wrap">
                    <input asp-for="Password" class="auth-input auth-input-has-toggle" autocomplete="current-password" placeholder="Nhập mật khẩu" />
                    <button type="button" class="auth-toggle-pwd" data-password-toggle="Password" aria-label="Hiện mật khẩu">Hiện</button>
                </div>
                <span asp-validation-for="Password" class="auth-field-error"></span>
            </div>

            <div class="auth-check-row">
                <label class="auth-checkbox-label">
                    <input asp-for="RememberMe" class="auth-checkbox" />
                    <span>Ghi nhớ đăng nhập</span>
                </label>
                <a asp-action="ForgotPassword" class="login-forgot-link">Quên mật khẩu?</a>
            </div>

            <button type="submit" class="cb-btn cb-btn-primary auth-submit-btn">Đăng nhập</button>
        </form>

        <p class="auth-switch-prompt">
            Chưa có tài khoản?
            <a asp-action="Register" asp-route-returnUrl="@ViewData["ReturnUrl"]">Đăng ký thành viên ngay</a>
        </p>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
    <script src="~/js/auth-ui.js" asp-append-version="true"></script>
}
