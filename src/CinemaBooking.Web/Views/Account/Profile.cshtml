@model ProfileViewModel
@{
    ViewData["Title"] = "Tài khoản";
}

<section class="page-head">
    <h1 class="page-title">Tài khoản của tôi</h1>
    <p class="cb-muted page-subtitle">Cập nhật thông tin liên hệ dùng khi đặt vé.</p>
</section>

@if (TempData["Success"] is string success)
{
    <div class="alert alert-success" role="alert">@success</div>
}

<div class="cb-card account-card">
    <form asp-action="Profile" method="post">
        <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

        <div class="mb-3">
            <label asp-for="Email" class="form-label">Email đăng nhập</label>
            <input asp-for="Email" class="form-control" readonly />
            <div class="form-text">Email dùng để đăng nhập và không thể đổi tại đây.</div>
        </div>

        <div class="mb-3">
            <label asp-for="FullName" class="form-label">Họ và tên</label>
            <input asp-for="FullName" class="form-control" autocomplete="name" />
            <span asp-validation-for="FullName" class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label asp-for="PhoneNumber" class="form-label">Số điện thoại</label>
            <input asp-for="PhoneNumber" class="form-control" autocomplete="tel" placeholder="0900000000" />
            <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
        </div>

        <div class="d-flex gap-2 flex-wrap">
            <button type="submit" class="btn btn-primary">Lưu thay đổi</button>
            <a asp-action="ChangePassword" class="btn btn-outline-secondary">Đổi mật khẩu</a>
            <a asp-controller="Booking" asp-action="MyBookings" class="btn btn-link">Vé của tôi</a>
        </div>
    </form>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
