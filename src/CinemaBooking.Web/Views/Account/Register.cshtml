@model RegisterViewModel
@{
    ViewData["Title"] = "Đăng ký thành viên";
}

@section Styles {
    <link rel="stylesheet" href="~/css/account.css" asp-append-version="true" />
}

<div class="register-layout">
    <div class="cr-auth-posters" aria-hidden="true">
        <img src="~/img/posters/dia-dao.jpg" alt="" /><img src="~/img/posters/inside-out-2.jpg" alt="" />
        <img src="~/img/posters/dune-part-two.jpg" alt="" /><img src="~/img/posters/nha-ba-nu.jpg" alt="" />
        <img src="~/img/posters/mat-biec.jpg" alt="" /><img src="~/img/posters/dia-dao.jpg" alt="" />
        <p class="cr-auth-tag">Một tài khoản, mọi suất chiếu.</p>
    </div>

    <!-- Cột phải: Form phẳng đăng ký -->
    <div class="register-form-col">
        <div class="register-form-head">
            <h1 class="register-form-title">Tạo tài khoản</h1>
            <p class="register-form-sub">Điền thông tin để đăng ký thành viên CinemaBooking.Smart.</p>
        </div>

        <form asp-action="Register" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post" class="auth-form">
            <div asp-validation-summary="ModelOnly" class="auth-validation-summary"></div>

            <div class="auth-field">
                <label asp-for="FullName" class="auth-label">Họ và tên</label>
                <div class="auth-input-wrap">
                    <input asp-for="FullName" class="auth-input" autocomplete="name" placeholder="Nguyễn Văn A" />
                </div>
                <span asp-validation-for="FullName" class="auth-field-error"></span>
            </div>

            <div class="auth-field">
                <label asp-for="Email" class="auth-label">Email</label>
                <div class="auth-input-wrap">
                    <input asp-for="Email" class="auth-input" autocomplete="username" placeholder="ban@example.com" />
                </div>
                <span asp-validation-for="Email" class="auth-field-error"></span>
            </div>

            <div class="auth-field">
                <label asp-for="Password" class="auth-label">Mật khẩu</label>
                <div class="auth-input-wrap">
                    <input asp-for="Password" class="auth-input auth-input-has-toggle" autocomplete="new-password"
                           placeholder="Tối thiểu 8 ký tự" data-password-input />
                    <button type="button" class="auth-toggle-pwd" data-password-toggle="Password"
                            aria-label="Hiện mật khẩu">Hiện</button>
                </div>
                <div class="auth-pwd-strength" data-password-strength hidden>
                    <div class="auth-pwd-track">
                        <div class="auth-pwd-bar" data-password-bar></div>
                    </div>
                    <span class="auth-pwd-label" data-password-label></span>
                </div>
                <span asp-validation-for="Password" class="auth-field-error"></span>
                <span class="auth-field-hint">Tối thiểu 8 ký tự, kết hợp chữ hoa, chữ thường và chữ số.</span>
            </div>

            <div class="auth-field">
                <label asp-for="ConfirmPassword" class="auth-label">Nhập lại mật khẩu</label>
                <div class="auth-input-wrap">
                    <input asp-for="ConfirmPassword" class="auth-input auth-input-has-toggle" autocomplete="new-password"
                           placeholder="Nhập lại mật khẩu vừa đặt" />
                    <button type="button" class="auth-toggle-pwd" data-password-toggle="ConfirmPassword"
                            aria-label="Hiện mật khẩu">Hiện</button>
                </div>
                <span asp-validation-for="ConfirmPassword" class="auth-field-error"></span>
            </div>

            <div class="register-terms-box">
                <input id="terms" type="checkbox" class="auth-checkbox" required />
                <label for="terms" class="auth-terms-text">
                    Tôi đồng ý với <a asp-controller="Home" asp-action="Privacy">Chính sách bảo mật</a> và các điều khoản dịch vụ của rạp.
                </label>
            </div>

            <button type="submit" class="cb-btn cb-btn-primary auth-submit-btn">Đăng ký thành viên</button>
        </form>

        <p class="auth-switch-prompt">
            Đã có tài khoản?
            <a asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]">Đăng nhập ngay</a>
        </p>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
    <script src="~/js/auth-ui.js" asp-append-version="true"></script>
}
