@model ResetPasswordViewModel
@{
    ViewData["Title"] = "Đặt lại mật khẩu";
}

@section Styles {
    <link rel="stylesheet" href="~/css/account.css" asp-append-version="true" />
}

<div class="reset-shell">
    <div class="reset-card">
        <div class="login-form-head">
            <div class="reset-target-badge">
                <span>Tài khoản: @Model.Email</span>
            </div>
            <h1 class="login-form-title">Đặt lại mật khẩu</h1>
            <p class="login-form-sub">Vui lòng thiết lập mật khẩu mới có độ bảo mật cao cho tài khoản của bạn.</p>
        </div>

        <form asp-action="ResetPassword" method="post" class="auth-form">
            <div asp-validation-summary="ModelOnly" class="auth-validation-summary"></div>
            <input asp-for="Email" type="hidden" />
            <input asp-for="Token" type="hidden" />

            <div class="auth-field">
                <label asp-for="Password" class="auth-label">Mật khẩu mới</label>
                <div class="auth-input-wrap">
                    <input asp-for="Password" class="auth-input auth-input-has-toggle" autocomplete="new-password"
                           placeholder="Tối thiểu 8 ký tự" data-password-input />
                    <button type="button" class="auth-toggle-pwd" data-password-toggle="Password"
                            aria-label="Hiện mật khẩu">Hiện</button>
                </div>
                <div class="auth-pwd-strength" data-password-strength hidden>
                    <div class="auth-pwd-track">
                        <div class="auth-pwd-bar" data-password-bar></div>
                    </div>
                    <span class="auth-pwd-label" data-password-label></span>
                </div>
                <span asp-validation-for="Password" class="auth-field-error"></span>
                <span class="auth-field-hint">Mật khẩu mới từ 8 ký tự trở lên, nên gồm cả chữ hoa và số.</span>
            </div>

            <div class="auth-field">
                <label asp-for="ConfirmPassword" class="auth-label">Nhập lại mật khẩu mới</label>
                <div class="auth-input-wrap">
                    <input asp-for="ConfirmPassword" class="auth-input auth-input-has-toggle" autocomplete="new-password"
                           placeholder="Nhập lại mật khẩu mới vừa đặt" />
                    <button type="button" class="auth-toggle-pwd" data-password-toggle="ConfirmPassword"
                            aria-label="Hiện mật khẩu">Hiện</button>
                </div>
                <span asp-validation-for="ConfirmPassword" class="auth-field-error"></span>
            </div>

            <button type="submit" class="cb-btn cb-btn-primary auth-submit-btn">Xác nhận đổi mật khẩu</button>
        </form>

        <p class="auth-switch-prompt">
            <a asp-action="Login">Quay lại trang đăng nhập</a>
        </p>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
    <script src="~/js/auth-ui.js" asp-append-version="true"></script>
}
