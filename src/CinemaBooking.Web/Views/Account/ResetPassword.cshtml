@model ResetPasswordViewModel
@{
    ViewData["Title"] = "Đặt lại mật khẩu";
}

<div class="auth-shell">
    <div class="cb-card auth-card">
        <div class="auth-brand">
            <span class="brand-mark" aria-hidden="true">🎬</span>
            <span>CinemaBooking<span class="brand-accent">.Smart</span></span>
        </div>

        <h1 class="auth-title">Đặt lại mật khẩu</h1>
        <p class="cb-muted auth-subtitle">Chọn mật khẩu mới cho tài khoản @Model.Email.</p>

        <form asp-action="ResetPassword" method="post">
            <div asp-validation-summary="ModelOnly" class="validation-summary"></div>
            <input asp-for="Email" type="hidden" />
            <input asp-for="Token" type="hidden" />

            <div class="mb-3">
                <label asp-for="Password" class="form-label">Mật khẩu mới</label>
                <div class="pwd-field">
                    <input asp-for="Password" class="form-control" autocomplete="new-password" />
                    <button type="button" class="pwd-toggle" data-password-toggle="Password"
                            aria-label="Hiện mật khẩu">👁️</button>
                </div>
                <span asp-validation-for="Password" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="ConfirmPassword" class="form-label">Nhập lại mật khẩu mới</label>
                <div class="pwd-field">
                    <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                    <button type="button" class="pwd-toggle" data-password-toggle="ConfirmPassword"
                            aria-label="Hiện mật khẩu">👁️</button>
                </div>
                <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
            </div>

            <button type="submit" class="btn btn-primary w-100">Đặt lại mật khẩu</button>
        </form>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
    <script src="~/js/auth-ui.js" asp-append-version="true"></script>
}
