@model HomeIndexViewModel
@{
    ViewData["Title"] = "Phim đang chiếu";

    string GenreLink(string? genre) => Url.Action("Index", new { q = Model.Keyword, genre })!;

}

@if (Model.HasMovies && !Model.IsFiltered)
{
    var feat = Model.NowShowing.Count > 0 ? Model.NowShowing[0] : Model.Movies[0];
    <section class="cr-hero" aria-labelledby="hero-title">
        <img class="cr-hero-bg" src="@feat.PosterOrPlaceholder" alt="" aria-hidden="true" />
        <div class="cr-hero-in">
            <a asp-controller="Movies" asp-action="Details" asp-route-id="@feat.Id" tabindex="-1" aria-hidden="true">
                <img class="cr-hero-poster" src="@feat.PosterOrPlaceholder" data-poster-fallback="@MovieCardViewModel.PlaceholderPoster"
                     alt="" width="260" height="390" />
            </a>
            <div class="cr-hero-copy">
                <small>Đang chiếu · @feat.GenreOrDefault</small>
                <h1 id="hero-title" class="cb-page-title">@feat.Title</h1>
                <p class="cr-hero-meta">@feat.DurationMinutes phút, khởi chiếu @feat.ReleaseDate.ToString("dd/MM/yyyy")</p>
                <a class="cb-btn cb-btn-primary" asp-controller="Movies" asp-action="Details" asp-route-id="@feat.Id">Chọn suất chiếu</a>
            </div>
        </div>
    </section>
}
else
{
    <section class="cr-card">
        <small>Rạp CinemaBooking</small>
        <h1 class="cb-page-title">Phim đang chiếu</h1>
    </section>
}

<div class="cr-toolbar">
    <form method="get" asp-action="Index" class="cr-search" role="search">
        <datalist id="movie-suggestions">
            @foreach (var sg in Model.SuggestionOptions) { <option value="@sg"></option> }
        </datalist>
        <label for="q" class="visually-hidden">Tìm phim</label>
        <input id="q" name="q" type="search" value="@Model.Keyword" class="cb-input" list="movie-suggestions"
               placeholder="Tìm theo tên phim hoặc thể loại…" maxlength="100" autocomplete="off" />
        @if (Model.Genre is not null)
        {
            <input type="hidden" name="genre" value="@Model.Genre" />
        }
        <button type="submit" class="cb-btn cb-btn-primary">Tìm</button>
    </form>

    @if (Model.GenreOptions.Count > 0)
    {
        <nav class="cr-chips" aria-label="Lọc theo thể loại">
            <a href="@GenreLink(null)" class="cr-chip @(Model.Genre is null ? "is-active" : null)">Tất cả</a>
            @foreach (var g in Model.GenreOptions)
            {
                var isCurrent = string.Equals(g, Model.Genre, StringComparison.OrdinalIgnoreCase);
                <a href="@GenreLink(g)" class="cr-chip @(isCurrent ? "is-active" : null)"
                   aria-current="@(isCurrent ? "true" : null)">@g</a>
            }
        </nav>
    }
</div>

@if (Model.IsFiltered)
{
    <p class="cr-note">
        @Model.Movies.Count phim
        @if (Model.Keyword is not null) { <text>khớp “<strong>@Model.Keyword</strong>”</text> }
        @if (Model.Genre is not null) { <text>thuộc thể loại <strong>@Model.Genre</strong></text> }
        · <a asp-action="Index">Xóa bộ lọc</a>
    </p>
}

@if (!Model.HasMovies || Model.NowShowing.Count == 0 && Model.ComingSoon.Count == 0)
{
    <div class="cr-empty">
        @if (Model.IsFiltered)
        {
            <p class="cr-empty-title">Không tìm thấy phim phù hợp</p>
            <p>Thử từ khóa khác hoặc <a asp-action="Index">xem tất cả phim</a>.</p>
        }
        else
        {
            <p class="cr-empty-title">Chưa có phim nào</p>
            <p>
                Danh sách phim lấy trực tiếp từ database. Nếu bạn vừa tạo database mới,
                hãy chạy lại ứng dụng để phần seed dữ liệu mẫu khởi tạo.
            </p>
        }
    </div>
}
else
{
    <h2 class="cr-section">Phim đang chiếu</h2>
    <div class="cr-films">
        @foreach (var movie in Model.NowShowing)
        {
            <article class="cr-film">
                <a class="cr-film-poster" asp-controller="Movies" asp-action="Details" asp-route-id="@movie.Id" tabindex="-1" aria-hidden="true">
                    <img src="@movie.PosterOrPlaceholder" data-poster-fallback="@MovieCardViewModel.PlaceholderPoster"
                         alt="" width="120" height="180" loading="lazy" />
                </a>
                <div class="cr-film-body">
                    <p class="cr-film-genre">@movie.GenreOrDefault</p>
                    <h3 class="cr-film-title"><a asp-controller="Movies" asp-action="Details" asp-route-id="@movie.Id">@movie.Title</a></h3>
                    <p class="cr-film-meta">@movie.DurationMinutes phút, khởi chiếu @movie.ReleaseDate.ToString("dd/MM/yyyy")</p>
                    <a class="cr-chip cr-chip-go" asp-controller="Movies" asp-action="Details" asp-route-id="@movie.Id"
                       aria-label="Chọn suất chiếu phim @movie.Title">Chọn suất</a>
                </div>
            </article>
        }
    </div>

    @if (Model.ComingSoon.Count > 0)
    {
        <h2 class="cr-section">Sắp chiếu</h2>
        <div class="cr-films">
        @foreach (var movie in Model.ComingSoon)
        {
            <article class="cr-film">
                <a class="cr-film-poster" asp-controller="Movies" asp-action="Details" asp-route-id="@movie.Id" tabindex="-1" aria-hidden="true">
                    <img src="@movie.PosterOrPlaceholder" data-poster-fallback="@MovieCardViewModel.PlaceholderPoster"
                         alt="" width="120" height="180" loading="lazy" />
                </a>
                <div class="cr-film-body">
                    <p class="cr-film-genre">@movie.GenreOrDefault</p>
                    <h3 class="cr-film-title"><a asp-controller="Movies" asp-action="Details" asp-route-id="@movie.Id">@movie.Title</a></h3>
                    <p class="cr-film-meta">@movie.DurationMinutes phút, khởi chiếu @movie.ReleaseDate.ToString("dd/MM/yyyy")</p>
                    <a class="cr-chip cr-chip-go" asp-controller="Movies" asp-action="Details" asp-route-id="@movie.Id"
                       aria-label="Chọn suất chiếu phim @movie.Title">Chọn suất</a>
                </div>
            </article>
        }
        </div>
    }
}
