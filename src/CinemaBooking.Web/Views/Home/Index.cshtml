@model HomeIndexViewModel
@{
    ViewData["Title"] = "Phim đang chiếu";

    // Chip thể loại giữ nguyên từ khóa đang tìm, và ngược lại form tìm giữ thể loại (input ẩn).
    string GenreLink(string? genre) => Url.Action("Index", new { q = Model.Keyword, genre })!;

    // Poster cho banner hero: tối đa 6 phim đang chiếu.
    var heroMovies = Model.NowShowing.Take(6).ToList();
}

<section class="home-hero">
    <div class="home-hero-copy">
        <span class="hero-eyebrow">🎬 CinemaBooking.Smart</span>
        <h1 class="hero-title">Chọn phim hay.<br /><span>Giữ ghế trong vài giây.</span></h1>
        <p class="hero-sub">
            Đặt vé với sơ đồ ghế real-time, giữ ghế an toàn và nhận vé qua email — không cần xếp hàng.
        </p>
        <div class="hero-badges">
            <span class="hero-badge">⚡ Giữ ghế real-time</span>
            <span class="hero-badge">🎟️ Vé gửi qua email</span>
            <span class="hero-badge">🪑 Sơ đồ ghế trực quan</span>
        </div>
    </div>
    <div class="home-hero-art">
        @if (heroMovies.Count > 0)
        {
            <div class="hero-carousel" data-hero-carousel
                 aria-roledescription="carousel" aria-label="Poster phim đang chiếu">
                @for (var i = 0; i < heroMovies.Count; i++)
                {
                    var movie = heroMovies[i];
                    <a class="hero-slide @(i == 0 ? "is-active" : null)"
                       asp-controller="Movies" asp-action="Details" asp-route-id="@movie.Id"
                       aria-hidden="@(i == 0 ? "false" : "true")"
                       tabindex="@(i == 0 ? "0" : "-1")">
                        <img src="@movie.PosterOrPlaceholder"
                             data-poster-fallback="@MovieCardViewModel.PlaceholderPoster"
                             alt="Poster phim @movie.Title"
                             loading="eager" />
                        <span class="hero-slide-caption">
                            <strong>@movie.Title</strong>
                            <small>@movie.GenreOrDefault · @movie.DurationMinutes phút</small>
                        </span>
                    </a>
                }
                <div class="hero-dots" role="group" aria-label="Chọn poster phim">
                    @for (var i = 0; i < heroMovies.Count; i++)
                    {
                        <button type="button" class="hero-dot @(i == 0 ? "is-active" : null)"
                                data-hero-dot="@i" aria-label="Xem poster @heroMovies[i].Title"></button>
                    }
                </div>
            </div>
        }
        else
        {
            <div class="hero-poster-stack" aria-hidden="true">
                <span class="hero-poster p1">🎬</span>
                <span class="hero-poster p2">🍿</span>
                <span class="hero-poster p3">🎟️</span>
            </div>
        }
    </div>
</section>

<div class="home-toolbar cb-card">
    <form method="get" asp-action="Index" class="movie-search" role="search">
        <label for="q" class="visually-hidden">Tìm phim</label>
        <input id="q" name="q" type="search" value="@Model.Keyword" class="form-control" list="movie-suggestions"
               placeholder="Tìm theo tên phim hoặc thể loại…" maxlength="100" autocomplete="off" />
        <datalist id="movie-suggestions">
            @foreach (var s in Model.SuggestionOptions) { <option value="@s"></option> }
        </datalist>
        @if (Model.Genre is not null)
        {
            <input type="hidden" name="genre" value="@Model.Genre" />
        }
        <button type="submit" class="btn btn-primary">Tìm</button>
    </form>

    @if (Model.GenreOptions.Count > 0)
    {
        <nav class="filter-row genre-filter" aria-label="Lọc theo thể loại">
            <a href="@GenreLink(null)" class="filter-chip @(Model.Genre is null ? "active" : null)">Tất cả</a>
            @foreach (var g in Model.GenreOptions)
            {
                var isCurrent = string.Equals(g, Model.Genre, StringComparison.OrdinalIgnoreCase);
                <a href="@GenreLink(g)" class="filter-chip @(isCurrent ? "active" : null)"
                   aria-current="@(isCurrent ? "true" : null)">@g</a>
            }
        </nav>
    }
</div>

@if (Model.IsFiltered)
{
    <p class="cb-muted search-summary">
        @Model.Movies.Count phim
        @if (Model.Keyword is not null) { <text>khớp “<strong>@Model.Keyword</strong>”</text> }
        @if (Model.Genre is not null) { <text>thuộc thể loại <strong>@Model.Genre</strong></text> }
        · <a asp-action="Index">Xóa bộ lọc</a>
    </p>
}

<div class="section-head">
    <h2 class="section-title">Phim đang chiếu</h2>
    <span class="cb-muted">@Model.NowShowing.Count phim</span>
</div>

@if (!Model.HasMovies || Model.NowShowing.Count == 0 && Model.ComingSoon.Count == 0)
{
    <div class="cb-card empty-state">
        <div class="error-icon" aria-hidden="true">🎬</div>
        @if (Model.IsFiltered)
        {
            <p class="empty-title">Không tìm thấy phim phù hợp</p>
            <p class="cb-muted">Thử từ khóa khác hoặc <a asp-action="Index">xem tất cả phim</a>.</p>
        }
        else
        {
            <p class="empty-title">Chưa có phim nào</p>
            <p class="cb-muted">
                Danh sách phim lấy trực tiếp từ database. Nếu bạn vừa tạo database mới,
                hãy chạy lại ứng dụng để phần seed dữ liệu mẫu chạy.
            </p>
        }
    </div>
}
else
{
    <ul class="movie-list">
        @foreach (var movie in Model.NowShowing)
        {
            <li>
                <partial name="_MovieCard" model="movie" />
            </li>
        }
    </ul>

    @if (Model.ComingSoon.Count > 0)
    {
        <div class="section-head">
            <h2 class="section-title">Sắp chiếu</h2>
            <span class="cb-muted">@Model.ComingSoon.Count phim</span>
        </div>
        <ul class="movie-list">
            @foreach (var movie in Model.ComingSoon)
            {
                <li>
                    <partial name="_MovieCard" model="movie" />
                </li>
            }
        </ul>
    }
}

@section Scripts {
    <script src="~/js/hero-carousel.js" asp-append-version="true"></script>
}
