@model MovieDetailsViewModel
@{
    var m = Model.Movie;
    var f = Model.Filter;
    var day = Model.SelectedDate?.ToString("yyyy-MM-dd");

    string Link(string? date, string? city, int? theaterId) =>
        Url.Action("Details", new { id = m.Id, date, city, theaterId }) + "#lich-chieu";

    ViewData["Title"] = m.Title;
}

<a asp-controller="Home" asp-action="Index" class="cr-back">← Phim đang chiếu</a>

<section class="cr-card cr-movie-card">
    <img class="cr-poster" src="@m.PosterOrPlaceholder"
         data-poster-fallback="@MovieCardViewModel.PlaceholderPoster"
         alt="Poster phim @m.Title" width="160" height="240" />
    <small>@m.GenreOrDefault · @m.DurationMinutes phút · khởi chiếu @m.ReleaseDate.ToString("dd/MM/yyyy")</small>
    <h1 class="cb-page-title">@m.Title</h1>
    @if (!string.IsNullOrWhiteSpace(Model.Description))
    {
        <p class="cr-desc">@Model.Description</p>
    }
    <a href="#lich-chieu" class="cb-btn cb-btn-primary">Chọn suất chiếu</a>
</section>

<section id="lich-chieu" class="cr-schedule">
    <p class="cr-role">Lịch chiếu</p>

@if (Model.Dates.Count == 0)
        {
            <div class="cr-empty">
                <p class="cr-empty-title">Chưa có suất chiếu</p>
                <p>Phim này chưa có suất nào trong 7 ngày tới. Vui lòng quay lại sau nhé.</p>
            </div>
        }
        else
        {
            <nav class="cr-chips cr-dates" aria-label="Chọn ngày chiếu">
                @foreach (var d in Model.Dates)
                {
                    var isCurrent = d == Model.SelectedDate;
                    <a href="@Link(d.ToString("yyyy-MM-dd"), f.City, f.TheaterId)"
                       class="cr-chip @(isCurrent ? "is-active" : null)"
                       aria-current="@(isCurrent ? "date" : null)">@Model.DateLabel(d)</a>
                }
            </nav>

            <div class="cr-filters">
                <div class="cr-filter-row" role="group" aria-label="Lọc theo thành phố">
                    <span class="cr-filter-label">Thành phố</span>
                    <a href="@Link(day, null, null)" class="cr-chip @(f.City is null ? "is-active" : null)">Tất cả</a>
                    @foreach (var c in f.Cities)
                    {
                        <a href="@Link(day, c, null)" class="cr-chip @(c == f.City ? "is-active" : null)">@c</a>
                    }
                </div>
                <div class="cr-filter-row" role="group" aria-label="Lọc theo chi nhánh">
                    <span class="cr-filter-label">Chi nhánh</span>
                    <a href="@Link(day, f.City, null)" class="cr-chip @(f.TheaterId is null ? "is-active" : null)">Tất cả</a>
                    @foreach (var b in f.Branches)
                    {
                        <a href="@Link(day, b.City, b.Id)" class="cr-chip @(b.Id == f.TheaterId ? "is-active" : null)">@b.Name</a>
                    }
                </div>
            </div>

            @if (!Model.HasShowtimes)
            {
                <div class="cr-empty">
                    <p class="cr-empty-title">Không có suất phù hợp</p>
                    <p>
                        Ngày này không còn suất ở địa điểm bạn chọn.
                        @if (f.IsActive)
                        {
                            <a href="@Link(day, null, null)">Xem mọi chi nhánh</a>
                        }
                    </p>
                </div>
            }
            else
            {
                <div class="cr-branches">
                    @foreach (var branch in Model.Branches)
                    {
                        <article class="cr-credit">
                            <h3 class="cr-credit-title">@branch.TheaterName</h3>
                            <ul class="cr-credit-side cr-slots">
                                @foreach (var s in branch.Showtimes)
                                {
                                    <li>
                                        <a class="cr-chip cr-slot" href="@Url.Content($"~/Booking/SeatMap/{s.Id}")"
                                           title="@s.RoomName · kết thúc @s.EndLocal.ToString("HH:mm")">
                                            <span class="cr-slot-time">@s.StartLocal.ToString("HH:mm")</span>
                                            <span class="cr-slot-meta">@s.RoomName · @s.BasePrice.ToString("N0") đ</span>
                                        </a>
                                    </li>
                                }
                            </ul>
                            <p class="cr-credit-sub">@branch.City</p>
                        </article>
                    }
                </div>
            }
        }
</section>
