@using CinemaBooking.Web.Services
@model List<IGrouping<string, BranchListItem>>
@{
    ViewData["Title"] = "Hệ thống rạp";
}

<section class="cr-card">
    <small>@Model.Sum(g => g.Count()) chi nhánh · @Model.Count thành phố</small>
    <h1 class="cb-page-title">Hệ thống rạp</h1>
    <p class="cr-desc">Chọn phim ở trang chủ để xem lịch chiếu theo từng chi nhánh.</p>
</section>

@if (Model.Count == 0)
{
    <div class="cr-empty">
        <p class="cr-empty-title">Chưa có chi nhánh nào mở cửa</p>
        <p>Vui lòng quay lại sau nhé.</p>
    </div>
}
else
{
    @foreach (var city in Model)
    {
        <section aria-labelledby="city-@city.First().Id">
            <h2 id="city-@city.First().Id" class="cr-role">@city.Key</h2>
            @foreach (var b in city)
            {
                <article class="cr-credit cr-branch">
                    <h3 class="cr-credit-title">@b.Name</h3>
                    <div class="cr-credit-side cr-branch-info">
                        <p>@(b.Address ?? "Đang cập nhật địa chỉ")</p>
                        <p class="cb-muted">@b.RoomCount phòng chiếu</p>
                    </div>
                </article>
            }
        </section>
    }
    <p class="cr-note"><a asp-controller="Home" asp-action="Index">Xem phim đang chiếu</a></p>
}
