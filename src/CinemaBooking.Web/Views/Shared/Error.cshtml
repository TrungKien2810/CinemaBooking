@model ErrorViewModel
@{
    ViewData["Title"] = "Có lỗi xảy ra";
}

<div class="error-shell">
    <div class="cb-card error-card">
        <div class="error-icon" aria-hidden="true">⚠️</div>
        <h1>Có lỗi xảy ra</h1>
        <p class="cb-muted">
            Hệ thống chưa xử lý được yêu cầu này. Bạn thử tải lại trang hoặc quay về trang chủ nhé.
        </p>

        @if (Model.ShowRequestId)
        {
            <p class="cb-muted" style="font-size: 0.8rem">
                Mã yêu cầu: <code>@Model.RequestId</code>
            </p>
        }

        <div class="d-flex gap-2 justify-content-center flex-wrap mt-3">
            <a class="btn btn-primary" asp-area="" asp-controller="Home" asp-action="Index">Về trang chủ</a>
            <a class="btn btn-outline-secondary" href="javascript:history.back()">Quay lại</a>
        </div>
    </div>
</div>
