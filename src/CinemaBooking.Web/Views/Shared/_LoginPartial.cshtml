@inject SignInManager<ApplicationUser> SignInManager

@{
    var displayName = User.Identity?.Name ?? "";
    var initial = string.IsNullOrWhiteSpace(displayName)
        ? "?"
        : displayName.Substring(0, 1).ToUpperInvariant();
}

@*
    Hiển thị tên đăng nhập lấy từ cookie (User.Identity.Name), KHÔNG gọi
    UserManager.GetUserAsync — partial này nằm trong layout nên chạy ở mọi trang,
    một lần query DB ở đây là một lần query thừa trên toàn site.
*@

<ul class="navbar-nav account-nav">
    @if (SignInManager.IsSignedIn(User))
    {
        <li class="nav-item dropdown">
            <a class="nav-link dropdown-toggle account-name" href="#" role="button"
               data-bs-toggle="dropdown" aria-expanded="false">
                <span class="account-avatar" aria-hidden="true">@initial</span>
                <span class="account-email">@displayName</span>
            </a>
            <ul class="dropdown-menu dropdown-menu-end">
                @if (User.IsInRole(AppRoles.Admin))
                {
                    @* Role nằm sẵn trong claim của cookie — kiểm tra không tốn query. *@
                    <li><a class="dropdown-item" asp-area="Admin" asp-controller="Movies" asp-action="Index">Trang quản trị</a></li>
                    <li><hr class="dropdown-divider" /></li>
                }
                else if (User.IsInRole(AppRoles.BranchAdmin))
                {
                    @* BranchAdmin chỉ vào được phòng/ghế và suất chiếu của chi nhánh mình. *@
                    <li><a class="dropdown-item" asp-area="Admin" asp-controller="Rooms" asp-action="Index">Quản lý chi nhánh</a></li>
                    <li><hr class="dropdown-divider" /></li>
                }
                <li>
                    <a class="dropdown-item" asp-controller="Booking" asp-action="MyBookings">Vé của tôi</a>
                </li>
                <li>
                    <a class="dropdown-item" asp-controller="Account" asp-action="Profile">Tài khoản</a>
                </li>
                <li>
                    <a class="dropdown-item" asp-controller="Account" asp-action="ChangePassword">Đổi mật khẩu</a>
                </li>
                <li>
                    <form asp-area="" asp-controller="Account" asp-action="Logout" method="post">
                        <button type="submit" class="dropdown-item">Đăng xuất</button>
                    </form>
                </li>
            </ul>
        </li>
    }
    else
    {
        <li class="nav-item">
            <a class="nav-link" asp-area="" asp-controller="Account" asp-action="Login">Đăng nhập</a>
        </li>
        <li class="nav-item">
            <a class="btn btn-primary btn-sm nav-cta" asp-area="" asp-controller="Account" asp-action="Register">Đăng ký</a>
        </li>
    }
</ul>
