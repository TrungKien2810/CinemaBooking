@inject SignInManager<ApplicationUser> SignInManager

@{
    var displayName = User.Identity?.Name ?? "";
    var initial = string.IsNullOrWhiteSpace(displayName)
        ? "?"
        : displayName.Substring(0, 1).ToUpperInvariant();
}

<div class="cb-account-dropdown">
    <button type="button" class="cb-account-trigger" data-account-trigger
            aria-expanded="false" aria-haspopup="true" aria-label="Menu tài khoản">
        <span class="cb-account-avatar" aria-hidden="true">@initial</span>
        <span class="cb-strip-label">Tài khoản</span>
    </button>

    <div class="cb-account-menu" data-account-menu hidden role="menu">
        @if (SignInManager.IsSignedIn(User))
        {
            <div class="cb-account-header">
                <div class="cb-account-user-name" title="@displayName">@displayName</div>
                @if (User.IsInRole(AppRoles.Admin))
                {
                    <span class="cb-account-badge">Quản trị viên</span>
                }
                else if (User.IsInRole(AppRoles.BranchAdmin))
                {
                    <span class="cb-account-badge">Quản lý chi nhánh</span>
                }
                else
                {
                    <span class="cb-account-badge">Thành viên</span>
                }
            </div>

            @if (User.IsInRole(AppRoles.Admin))
            {
                <a class="cb-account-item" asp-area="Admin" asp-controller="Dashboard" asp-action="Index" role="menuitem">
                    Trang quản trị
                </a>
                <div class="cb-account-divider"></div>
            }
            else if (User.IsInRole(AppRoles.BranchAdmin))
            {
                <a class="cb-account-item" asp-area="Admin" asp-controller="Dashboard" asp-action="Index" role="menuitem">
                    Quản lý chi nhánh
                </a>
                <div class="cb-account-divider"></div>
            }

            @if (!User.IsInRole(AppRoles.Admin) && !User.IsInRole(AppRoles.BranchAdmin))
            {
                @* Tài khoản quản trị không mua vé nên không có mục "Vé của tôi". *@
                <a class="cb-account-item" asp-area="" asp-controller="Booking" asp-action="MyBookings" role="menuitem">
                    Vé của tôi
                </a>
            }
            <a class="cb-account-item" asp-area="" asp-controller="Account" asp-action="Profile" role="menuitem">
                Hồ sơ cá nhân
            </a>
            <a class="cb-account-item" asp-area="" asp-controller="Account" asp-action="ChangePassword" role="menuitem">
                Đổi mật khẩu
            </a>

            <div class="cb-account-divider"></div>

            <form asp-area="" asp-controller="Account" asp-action="Logout" method="post">
                <button type="submit" class="cb-account-item cb-account-logout" style="width: 100%;" role="menuitem">
                    Đăng xuất
                </button>
            </form>
        }
        else
        {
            <div class="cb-account-header">
                <div class="cb-account-user-name">Khách xem phim</div>
                <span class="cb-account-badge">Chưa đăng nhập</span>
            </div>

            <a class="cb-account-item" asp-area="" asp-controller="Account" asp-action="Login" role="menuitem">
                Đăng nhập
            </a>
            <a class="cb-account-item cb-account-cta" asp-area="" asp-controller="Account" asp-action="Register" role="menuitem">
                Đăng ký thành viên
            </a>
        }
    </div>
</div>
