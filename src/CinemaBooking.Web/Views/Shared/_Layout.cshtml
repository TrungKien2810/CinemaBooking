@{
    var controller = ViewContext.RouteData.Values["controller"] as string;
    var action = ViewContext.RouteData.Values["action"] as string;

    bool IsCurrent(string c, string a) =>
        string.Equals(controller, c, StringComparison.OrdinalIgnoreCase) &&
        string.Equals(action, a, StringComparison.OrdinalIgnoreCase);

    string NavClass(string c, string a) => IsCurrent(c, a) ? "cr-link is-active" : "cr-link";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="CinemaBooking.Smart — đặt vé xem phim, giữ ghế real-time và nhận vé qua email." />
    <title>@ViewData["Title"] · CinemaBooking.Smart</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;700&family=Cormorant+Garamond:ital,wght@0,500;0,600;0,700;1,500&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/tokens.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/base.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/features.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
    <link rel="stylesheet" href="~/css/credits.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/CinemaBooking.Web.styles.css" asp-append-version="true" />
</head>
<body>
    <a class="skip-link" href="#main-content">Bỏ qua điều hướng</a>

    <header class="cr-bar">
        <a class="cr-brand" asp-area="" asp-controller="Home" asp-action="Index" aria-label="Trang chủ CinemaBooking">Cinema<span>Booking</span></a>
        <nav class="cr-nav" aria-label="Điều hướng chính">
            <a class="@NavClass("Home", "Index")" asp-area="" asp-controller="Home" asp-action="Index" aria-current="@(IsCurrent("Home", "Index") ? "page" : null)">Phim</a>
            <a class="@NavClass("Branches", "Index")" asp-area="" asp-controller="Branches" asp-action="Index" aria-current="@(IsCurrent("Branches", "Index") ? "page" : null)">Rạp</a>
            <a class="@NavClass("Prices", "Index")" asp-area="" asp-controller="Prices" asp-action="Index" aria-current="@(IsCurrent("Prices", "Index") ? "page" : null)">Giá vé</a>
            <a class="@NavClass("Booking", "Lookup")" asp-area="" asp-controller="Booking" asp-action="Lookup" aria-current="@(IsCurrent("Booking", "Lookup") ? "page" : null)">Tra cứu</a>
            @if (!User.IsInRole(AppRoles.Admin) && !User.IsInRole(AppRoles.BranchAdmin))
            {
                <a class="@NavClass("Booking", "MyBookings")" asp-area="" asp-controller="Booking" asp-action="MyBookings" aria-current="@(IsCurrent("Booking", "MyBookings") ? "page" : null)">Vé của tôi</a>
            }
        </nav>
        <div class="cr-account"><partial name="_LoginPartial" /></div>
    </header>

    <main id="main-content" role="main" class="cr-main">
        @RenderBody()
    </main>

    <footer class="cr-footer">
        <p class="cr-footer-end">Hết</p>
        <p>&copy; @DateTime.Now.Year CinemaBooking.Smart · Đồ án PRN222</p>
        <nav aria-label="Liên kết chân trang">
            <a asp-area="" asp-controller="Home" asp-action="Index">Phim đang chiếu</a>
            <a asp-area="" asp-controller="Prices" asp-action="Index">Bảng giá vé</a>
            <a asp-area="" asp-controller="Booking" asp-action="Lookup">Tra cứu vé</a>
            <a asp-area="" asp-controller="Home" asp-action="Privacy">Riêng tư</a>
        </nav>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
