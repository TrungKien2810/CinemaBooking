@{
    var controller = ViewContext.RouteData.Values["controller"] as string;
    var action = ViewContext.RouteData.Values["action"] as string;

    bool IsCurrent(string c, string a) =>
        string.Equals(controller, c, StringComparison.OrdinalIgnoreCase) &&
        string.Equals(action, a, StringComparison.OrdinalIgnoreCase);

    string NavClass(string c, string a) => IsCurrent(c, a) ? "nav-link active" : "nav-link";
}
<!DOCTYPE html>
<html lang="vi" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="CinemaBooking.Smart — đặt vé xem phim, giữ ghế real-time và nhận vé qua email." />
    <title>@ViewData["Title"] · CinemaBooking.Smart</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/ui-refresh.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/seats.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/polish.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/CinemaBooking.Web.styles.css" asp-append-version="true" />
</head>
<body>
    <a class="skip-link" href="#main-content">Bỏ qua điều hướng</a>

    <header>
        <nav class="navbar navbar-expand-lg site-navbar" aria-label="Điều hướng chính">
            <div class="container">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">
                    <span class="brand-mark" aria-hidden="true">🎬</span>
                    <span class="brand-text">CinemaBooking<span class="brand-accent">.Smart</span></span>
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
                        data-bs-target="#siteNav" aria-controls="siteNav"
                        aria-expanded="false" aria-label="Mở menu">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="siteNav">
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item">
                            <a class="@NavClass("Home", "Index")" asp-area="" asp-controller="Home" asp-action="Index"
                               aria-current="@(IsCurrent("Home", "Index") ? "page" : null)">Phim đang chiếu</a>
                        </li>
                        <li class="nav-item">
                            <a class="@NavClass("Branches", "Index")" asp-area="" asp-controller="Branches" asp-action="Index"
                               aria-current="@(IsCurrent("Branches", "Index") ? "page" : null)">Hệ thống rạp</a>
                        </li>
                        <li class="nav-item">
                            <a class="@NavClass("Prices", "Index")" asp-area="" asp-controller="Prices" asp-action="Index"
                               aria-current="@(IsCurrent("Prices", "Index") ? "page" : null)">Bảng giá</a>
                        </li>
                        <li class="nav-item">
                            <a class="@NavClass("Booking", "Lookup")" asp-area="" asp-controller="Booking" asp-action="Lookup"
                               aria-current="@(IsCurrent("Booking", "Lookup") ? "page" : null)">Tra cứu vé</a>
                        </li>
                    </ul>
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>

    <main id="main-content" role="main" class="site-main">
        <div class="container">
            @RenderBody()
        </div>
    </main>

    <footer class="site-footer">
        <div class="container">
            <div class="footer-grid">
                <div>
                    <div class="footer-brand">🎬 CinemaBooking.Smart</div>
                    <p class="footer-note">
                        Đồ án môn PRN — đặt vé xem phim với giữ ghế real-time bằng SignalR.
                    </p>
                </div>
                <div>
                    <div class="footer-heading">Khám phá</div>
                    <ul class="footer-links">
                        <li><a asp-area="" asp-controller="Home" asp-action="Index">Phim đang chiếu</a></li>
                        <li><a asp-area="" asp-controller="Branches" asp-action="Index">Hệ thống rạp</a></li>
                        <li><a asp-area="" asp-controller="Prices" asp-action="Index">Bảng giá vé</a></li>
                        <li><a asp-area="" asp-controller="Booking" asp-action="Lookup">Tra cứu vé</a></li>
                    </ul>
                </div>
                <div>
                    <div class="footer-heading">Tài khoản</div>
                    <ul class="footer-links">
                        <li><a asp-area="" asp-controller="Account" asp-action="Login">Đăng nhập</a></li>
                        <li><a asp-area="" asp-controller="Account" asp-action="Register">Đăng ký</a></li>
                        <li><a asp-area="" asp-controller="Home" asp-action="Privacy">Chính sách riêng tư</a></li>
                    </ul>
                </div>
            </div>
            <div class="footer-bottom">
                &copy; @DateTime.Now.Year CinemaBooking.Smart · Đồ án PRN222
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/price-input.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
