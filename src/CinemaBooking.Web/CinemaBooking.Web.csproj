<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\CinemaBooking.Domain\CinemaBooking.Domain.csproj" />
    <ProjectReference Include="..\CinemaBooking.Infrastructure\CinemaBooking.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Test gọi thẳng CleanOnceAsync (internal) thay vì chờ PeriodicTimer của BackgroundService. -->
    <InternalsVisibleTo Include="CinemaBooking.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="QRCoder" Version="1.6.0" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Bí mật VNPAY (HashSecret) nằm trong user-secrets, không commit vào appsettings.json. -->
    <UserSecretsId>cinemabooking-web-vnpay</UserSecretsId>
  </PropertyGroup>

</Project>
